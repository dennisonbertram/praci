{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": { "eq": "www.praci.ai" } }],
      "destination": "https://praci.ai/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": { "eq": "www.praci.ai" } }],
      "destination": "https://praci.ai/:path*",
      "statusCode": 301
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    }
  ]
}
