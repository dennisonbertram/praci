---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <title>Praci</title>
  </head>
  <body>
    <main>
      <h1>Praci</h1>
      <div id="result" hidden>
        <p class="big" id="standing"></p>
        <p>Each friend who joins moves you up 10 places.</p>
        <div class="row">
          <input id="link" readonly aria-label="Referral link" />
          <button id="copy" type="button">Copy link</button>
        </div>
      </div>
      <p id="status" aria-live="polite"></p>
    </main>
    <script>
      const status = document.querySelector<HTMLElement>("#status")!;
      const result = document.querySelector<HTMLElement>("#result")!;
      const link = document.querySelector<HTMLInputElement>("#link")!;
      const token = new URLSearchParams(location.search).get("token");

      async function load() {
        if (!token) throw new Error();
        const response = await fetch("/api/me", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ token }),
        });
        if (!response.ok) throw new Error();
        const data = await response.json();
        document.querySelector("#standing")!.textContent = `You're #${data.position} of ${data.total}.`;
        link.value = data.referralUrl;
        result.hidden = false;
      }
      load().catch(() => {
        status.textContent = "Something went wrong. Try again.";
      });

      document.querySelector("#copy")!.addEventListener("click", () => {
        navigator.clipboard.writeText(link.value).catch(() => link.select());
      });
    </script>
  </body>
</html>
