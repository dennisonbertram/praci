---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Praci</title>
    <meta name="description" content="An open-source AI coworker. Join the waitlist." />
  </head>
  <body>
    <main>
      <h1>Praci</h1>
      <p>An open-source AI coworker. Join the waitlist.</p>
      <form id="join" novalidate>
        <label class="sr-only" for="email">Email address</label>
        <input id="email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="none" spellcheck="false" maxlength="254" required />
        <div hidden><input name="contactNote" type="text" autocomplete="off" tabindex="-1" /></div>
        <button type="submit">Join</button>
      </form>
      <p id="status" aria-live="polite"></p>
    </main>
    <script>
      const form = document.querySelector<HTMLFormElement>("#join")!;
      const status = document.querySelector<HTMLElement>("#status")!;
      const email = form.elements.namedItem("email") as HTMLInputElement;
      const note = form.elements.namedItem("contactNote") as HTMLInputElement;
      const submit = form.querySelector("button")!;
      const ref = new URLSearchParams(location.search).get("ref") ?? undefined;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!email.checkValidity()) return email.reportValidity();
        submit.disabled = true;
        status.textContent = "";
        try {
          const response = await fetch("/api/join", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ email: email.value, ref, contactNote: note.value }),
          });
          if (!response.ok) throw new Error();
          form.hidden = true;
          status.textContent = "Check your email to confirm.";
        } catch {
          status.textContent = "Something went wrong. Try again.";
          submit.disabled = false;
        }
      });
    </script>
  </body>
</html>
