---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const day = (date: Date) => date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<DocsLayout title="Blog" description="Worked examples of running a company on Praci.">
  <h1>Blog</h1>
  <p class="lede">Worked examples of running a company on Praci.</p>
  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
          <p>{post.data.description}</p>
          <p class="meta">{day(post.data.date)}</p>
        </li>
      ))
    }
  </ul>
</DocsLayout>
