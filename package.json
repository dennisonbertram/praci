{
  "name": "rakazo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "connect": "node scripts/connect/connect.mjs",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "design-system": "node scripts/design-system.mjs --write",
    "design-system:check": "node scripts/design-system.mjs --check",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @rakazo/db generate",
    "db:migrate": "pnpm --filter @rakazo/api db:migrate",
    "sandbox:build": "docker build -t rakazo/computer:local infra/sandboxes/computer",
    "test": "vitest run",
    "test:compose-smoke": "bash infra/compose/run-smokes.sh",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:mobile-screenshots": "pnpm --filter @rakazo/db generate && tsx packages/testkit/src/cli/mobile-screenshots.ts",
    "ios:screenshots": "pnpm --filter @rakazo/db generate && tsx packages/testkit/src/cli/ios-app-screenshots.ts",
    "ios:tokens": "tsx packages/ui-tokens/src/generate-swift.ts",
    "ios:tokens:check": "tsx packages/ui-tokens/src/generate-swift.ts --check",
    "ios:test": "bash apps/ios/scripts/test.sh",
    "contracts:generate": "tsx packages/contracts/scripts/openapi.ts",
    "contracts:check": "tsx packages/contracts/scripts/openapi.ts --check",
    "contracts:record-fixtures": "tsx packages/contracts/scripts/record-health-fixture.ts",
    "demo:up": "pnpm --filter @rakazo/db generate && tsx packages/testkit/src/cli/demo.ts up",
    "demo:down": "tsx packages/testkit/src/cli/demo.ts down",
    "test:topology": "tsx packages/testkit/src/cli/topology.ts",
    "test:canary": "tsx packages/testkit/src/cli/canary.ts",
    "test:pi": "vitest run packages/testkit/src/model-emulator.test.ts packages/testkit/src/pi-offline.test.ts",
    "test:evals": "tsx packages/testkit/src/cli/evals.ts",
    "test:company-eval": "tsx packages/testkit/src/cli/company-eval.ts",
    "test:computer-replay": "tsx packages/testkit/src/cli/computer-replay.ts",
    "test:computer": "tsx packages/testkit/src/cli/computer.ts",
    "perf:desktop": "tsx packages/testkit/src/cli/desktop-performance.ts",
    "perf:compare": "tsx packages/testkit/src/cli/compare-performance.ts",
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down -v",
    "desktop:images": "scripts/build-desktop-images.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "qrcode": "1.5.4",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "proxy-addr@<2.0.8": "2.0.8",
      "dompurify@<3.4.17": "3.4.17",
      "e2b>undici8": "npm:undici@8.12.3",
      "undici@>=7 <7.30.2": "7.30.2",
      "undici@<6.29.1": "6.29.1",
      "undici@>=8 <8.12.3": "8.12.3",
      "fast-uri@<3.1.9": "3.1.9",
      "ip-address@<10.7.4": "10.7.4",
      "nodemailer@<10.4.1": "10.4.1",
      "node-forge@<1.4.3": "1.4.3",
      "@xmldom/xmldom@>=0.8 <0.8.15": "0.8.15",
      "@xmldom/xmldom@>=0.9 <0.9.12": "0.9.12",
      "brace-expansion@>=2 <2.1.7": "2.1.7",
      "compression@<1.8.2": "1.8.2",
      "fast-xml-parser@>=5 <5.12.0": "5.12.0",
      "glob@>=13 <13.0.7": "13.0.7",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "markdown-it@>=14 <14.3.3": "14.3.3",
      "mysql2@<3.22.0": "3.22.0",
      "brace-expansion@>=4 <5.0.11": "5.0.11",
      "axios@>=1 <1.20.0": "1.20.0",
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "1.14.5",
      "devalue@<5.9.3": "5.9.3",
      "source-map-js@<1.2.2": "1.2.2",
      "sharp@<0.35.5": "0.35.5",
      "shell-quote@<1.11.0": "1.11.0",
      "follow-redirects@<1.16.2": "1.16.2",
      "vite@>=8.3.0 <8.3.3": "8.3.3",
      "zod@>=4 <4.6.6": "4.6.6",
      "body-parser@>=2 <2.4.0": "2.4.0",
      "svgo@>=4 <4.1.0": "4.1.0",
      "decode-uri-component@<0.5.1": "0.5.1"
    },
    "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
    },
    "neverBuiltDependencies": [
      "@openuidev/lang-core"
    ]
  }
}
