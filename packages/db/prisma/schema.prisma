generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AiDataConsent {
  userId       String
  spaceId      String
  recipientKey String
  version      String
  grantedAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  space        Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceMember  SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)

  @@id([userId, spaceId, recipientKey])
  @@map("ai_data_consents")
}

model User {
  approvalDecisions ApprovalDecision[]
  equityLedgers     EquityLedger[]
  pipelineRecords PipelineRecord[]
  pipelineImports PipelineImport[]
  scratchpadApprovals         ScratchpadApproval[]
  aiDataConsents              AiDataConsent[]
  mailSearches                MailSearch[]
  contacts                    Contact[]
  contactPhotos               ContactPhoto[]
  capTableSnapshots           CapTableSnapshot[]
  investorUpdates             InvestorUpdate[]
  investorShares              InvestorShare[]
  investorShareRequests       InvestorShareRequest[]
  investorPortalTokens        InvestorPortalToken[]
  portalSessions              PortalSession[]
  auditRequests               AuditRequest[]
  fundraiseRounds             FundraiseRound[]
  safes                       Safe[]
  safeSyncStates              SafeSyncState[]
  sidebarPages                SidebarPage[]
  notifications               Notification[]
  notificationEndpoints       NotificationEndpoint[]
  accountExports              AccountExport[]
  passkeys                    Passkey[]
  oauthClients                OauthClient[]
  oauthAccessTokens           OauthAccessToken[]
  oauthRefreshTokens          OauthRefreshToken[]
  oauthConsents               OauthConsent[]
  mcpConnections              McpConnection[]
  id                          String                       @id
  name                        String
  email                       String
  emailVerified               Boolean                      @default(false)
  image                       String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  avatarStyle                 String                       @default("organic")
  /// IANA time zone reported by the owner's clients; null until one signs in.
  timezone                    String?
  /// Set when the owner finishes or skips the first-run tour; null means it has not been shown.
  tourSeenAt                  DateTime?
  hiddenPages                 String[]                     @default([])
  /// Masks money figures in this user's clients; follows the person, not the browser.
  hideAmounts                 Boolean                      @default(false)
  sessions                    Session[]
  accounts                    Account[]
  cachedMailMessages          CachedMailMessage[]
  mailSenderStats             MailSenderStat[]
  mailSenderDecisions         MailSenderDecision[]
  mailActionLogs              MailActionLog[]
  inboxTodos                  InboxTodo[]
  meetings                    Meeting[]
  meetingCaptures             MeetingCapture[]
  meetingSyncStates           MeetingSyncState[]
  meetingTombstones           MeetingTombstone[]
  meetingHandoffs             MeetingHandoff[]
  inboxSenderFeedback         InboxSenderFeedback[]
  composeSends                ComposeSend[]
  mailReplyItems              MailReplyItem[]
  members                     Member[]
  invitations                 Invitation[]
  modelCredentials            UserModelCredential[]
  voiceCredentials            UserVoiceCredential[]
  transcriptionSelection      TranscriptionSelection?
  secrets                     Secret[]
  mcpServers                  McpServer[]
  botSections                 BotSection[]
  actionApprovalRules         ActionApprovalRule[]
  actionAutoReviewPreferences ActionAutoReviewPreference[]
  createdSpaces               Space[]                      @relation("SpaceCreator")
  botSecrets                  BotSecret[]
  agentSecrets                AgentSecret[]
  createdTickets              Ticket[]                     @relation("TicketCreatorUser")
  ticketComments              TicketComment[]              @relation("TicketCommentAuthorUser")
  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  oauthAccessTokens    OauthAccessToken[]
  oauthRefreshTokens   OauthRefreshToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Better Auth passkey plugin credentials; one row per registered authenticator.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

/// Better Auth JWT plugin signing keys; the OAuth provider signs MCP access tokens with them.
model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

/// An outside application registered with the OAuth provider (MCP clients register themselves).
model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  accessTokens                     OauthAccessToken[]
  refreshTokens                    OauthRefreshToken[]
  consents                         OauthConsent[]
  resources                        OauthClientResource[]

  @@index([userId])
  @@map("oauth_client")
}

/// A protected resource the OAuth provider issues tokens for (the MCP endpoint).
model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  /// A list, or null to inherit the provider's scopes. Better Auth writes null, which a Postgres list cannot hold.
  allowedScopes                 Json?
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id
  token                   String?            @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

/// What a user allowed a client to do. `referenceId` is the Space the user chose.
model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

/// Single-use client assertion ids (private_key_jwt); unused by the public MCP clients.
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertion")
}

/// One outside client connected to one Space by one member. Every MCP call re-checks it.
model McpConnection {
  id            String    @id @default(cuid())
  spaceId       String
  space         Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "oauth" or "pat" (personal access token).
  kind          String
  label         String
  clientName    String?
  oauthClientId String?
  /// Id of an OAuth grant, carried by its consent reference and every token it issued; null for PATs.
  grantId       String?   @unique
  /// SHA-256 of a personal access token; null for OAuth connections.
  tokenHash     String?   @unique
  tokenPrefix   String?
  readOnly      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  /// Start of the minute that `rateCount` counts calls in (fixed-window rate limit).
  rateWindowStart DateTime?
  rateCount     Int       @default(0)
  calls         McpCallLog[]
  actions       ExternalAction[]

  @@index([spaceId])
  // mcp_connections_one_live_grant_key is raw SQL (partial unique on userId, spaceId, oauthClientId
  // over live OAuth rows).
  @@index([userId, spaceId, oauthClientId])
  @@map("mcp_connections")
}

/// One tool call from an outside MCP client. Never holds arguments or results.
model McpCallLog {
  id           String        @id @default(cuid())
  connectionId String
  connection   McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  spaceId      String
  space        Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tool         String
  /// "ok", "error", "rate_limited", "pending" (waiting for approval) or "blocked".
  outcome      String
  durationMs   Int
  createdAt    DateTime      @default(now())

  @@index([connectionId, createdAt])
  @@map("mcp_call_log")
}

/// A write an outside MCP client asked for that the Space's rules say a person must approve first.
model ExternalAction {
  id           String        @id @default(cuid())
  spaceId      String
  space        Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String
  connectionId String
  connection   McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tool         String
  args         Json
  /// "pending", "approved" (claimed, running), "denied", "expired", "done" or "failed".
  status       String        @default("pending")
  result       Json?
  createdAt    DateTime      @default(now())
  decidedAt    DateTime?

  @@index([spaceId, userId, status])
  @@index([connectionId, createdAt])
  @@index([status, createdAt])
  @@map("external_actions")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth credential rate limits. `lastRequest` is epoch milliseconds.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Organization {
  id          String          @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  spaces      Space[]
  billing     BillingAccount?

  @@unique([slug])
  @@map("organization")
}

model BillingAccount {
  organizationId      String       @id
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId          String       @unique
  subscriptionId      String?
  subscriptionItemId  String?
  priceId             String?
  status              String?
  seats               Int?
  trialEndsAt         DateTime?
  currentPeriodEndsAt DateTime?
  cancelAtPeriodEnd   Boolean      @default(false)
  endedAt             DateTime?
  subscribedAt        DateTime?
  syncedAt            DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("billing_accounts")
}

model ActionApprovalRule {
  id              String   @id @default(cuid())
  spaceId         String
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  // always_allow, require_approval or block.
  effect          String
  // Null for a space-wide rule; a bot id for that bot's override.
  botId           String?
  bot             Bot?     @relation(fields: [botId], references: [id], onDelete: Cascade)
  // Set only on an "Always for this routine" rule: it applies to that routine's runs and nothing else.
  routineId       String?
  routine         Routine? @relation(fields: [routineId], references: [id], onDelete: Cascade)
  matchKind       String
  matchValue      String
  createdAt       DateTime @default(now())

  // One rule per target: unique index action_approval_rules_target_key (raw SQL in migrations
  // 20261227000000 and 20261231000053) on (spaceId, createdByUserId, COALESCE(botId, ''),
  // COALESCE(routineId, ''), matchKind, lower(matchValue)).
  @@index([spaceId, createdByUserId])
  @@index([botId])
  @@index([routineId])
  @@map("action_approval_rules")
}

// Durable log of approval decisions: who answered and how (WP0.2). It outlives the thread and
// the run so past decisions can inform the next one; it goes with the space or the account.
model ApprovalDecision {
  id               String   @id @default(cuid())
  spaceId          String
  space            Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId            String
  routineId        String?
  runId            String?
  effectId         String?
  externalActionId String?
  tool             String
  connectorKind    String?
  actionType       String?
  targetKey        String
  // approved, denied, edited, undone, auto_approved, auto_asked or blocked.
  decision         String
  basis            String
  // Null for an automatic decision.
  decidedByUserId  String?
  cleanRun         Boolean
  tier             String
  argsKeys         String[]
  argsSize         Int
  version          Int
  createdAt        DateTime @default(now())

  @@index([spaceId, userId, botId, tool, targetKey, createdAt])
  @@map("approval_decisions")
}

model ActionAutoReviewPreference {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  background Boolean @default(true)
  // "open", "ask_changes" or "ask_everything"; null follows RAKAZO_PERMISSIONS_DEFAULT. Owner-only.
  permissionLevel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, userId])
  @@map("action_auto_review_preferences")
}

model Member {
  id               String        @id
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String
  createdAt        DateTime
  spaceMemberships SpaceMember[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Space {
  approvalDecisions ApprovalDecision[]
  equityLedgers     EquityLedger[]
  runFragments RunFragment[]
  modelConnectionPauses ModelConnectionPause[]
  pipelineRecords PipelineRecord[]
  pipelineImports PipelineImport[]
  artifactShares              ArtifactShare[]
  scratchpadApprovals         ScratchpadApproval[]
  notifications               Notification[]
  notificationEndpoints       NotificationEndpoint[]
  aiDataConsents              AiDataConsent[]
  mcpCallLogs                 McpCallLog[]
  externalActions             ExternalAction[]
  omiUploads                  OmiUpload[]
  omiSegments                 OmiSegment[]
  meetingCaptures             MeetingCapture[]
  meetingCaptureChunks        MeetingCaptureChunk[]
  /// "remind", "confirm" or "off": whether and how meetings may be recorded here.
  meetingRecording            String                       @default("remind")
  brexCardReservations        BrexCardReservation[]
  mcpConnections              McpConnection[]
  id                          String                       @id
  organizationId              String
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                        String
  isDefault                   Boolean                      @default(false)
  createdByUserId             String?
  createdByUser               User?                        @relation("SpaceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                     @default(now())
  deletingAt                  DateTime?
  deletionClaimId             String?
  memberships                 SpaceMember[]
  bots                        Bot[]
  botSections                 BotSection[]
  botDeletions                BotDeletion[]
  threads                     Thread[]
  dataRoomFolders             DataRoomFolder[]
  dataRoomItems               DataRoomItem[]
  dataRoomImports             DataRoomImport[]
  dataRoomChanges             DataRoomChange[]
  dataRoomChunks              DataRoomChunk[]
  dataRoomItemTexts           DataRoomItemText[]
  dataRoomSyncStates          DataRoomSyncState[]
  events                      Event[]
  tasks                       Task[]
  runs                        Run[]
  routines                    Routine[]
  routineWatchStates          RoutineWatchState[]
  scratchpadItems             ScratchpadItem[]
  threadGoals                 ThreadGoal[]
  taughtSkills                TaughtSkill[]
  agentSkills                 AgentSkill[]
  mailSearches                MailSearch[]
  connections                 Connection[]
  cachedMailMessages          CachedMailMessage[]
  mailSenderStats             MailSenderStat[]
  mailSenderDecisions         MailSenderDecision[]
  mailActionLogs              MailActionLog[]
  inboxTodos                  InboxTodo[]
  meetings                    Meeting[]
  meetingSyncStates           MeetingSyncState[]
  meetingTombstones           MeetingTombstone[]
  meetingHandoffs             MeetingHandoff[]
  inboxSenderFeedback         InboxSenderFeedback[]
  composeSends                ComposeSend[]
  mailReplyItems              MailReplyItem[]
  capabilities                CapabilityInstall[]
  memoryDocuments             MemoryDocument[]
  botPages                    BotPage[]
  pageSources                 PageSource[]
  pageSourceSnapshots         PageSourceSnapshot[]
  appControlSnapshots         AppControlSnapshot[]
  botPins                     BotPins[]
  contacts                    Contact[]
  contactPhotos               ContactPhoto[]
  capTableSnapshots           CapTableSnapshot[]
  investorUpdates             InvestorUpdate[]
  investorShares              InvestorShare[]
  investorShareRequests       InvestorShareRequest[]
  investorPortalTokens        InvestorPortalToken[]
  portalSessions              PortalSession[]
  auditRequests               AuditRequest[]
  fundraiseRounds             FundraiseRound[]
  safes                       Safe[]
  safeSyncStates              SafeSyncState[]
  sidebarPages                SidebarPage[]
  agentHomes                  AgentHome[]
  browserProfiles             BrowserProfile[]
  artifacts                   Artifact[]
  usageRecords                UsageRecord[]
  notificationPreferences     NotificationPreference[]
  computers                   Computer[]
  externalEffects             ExternalEffect[]
  mcpServers                  McpServer[]
  mcpOAuthSessions            McpOAuthSession[]
  botMcpServers               BotMcpServer[]
  messagingIdentities         MessagingIdentity[]
  actionApprovalRules         ActionApprovalRule[]
  actionAutoReviewPreferences ActionAutoReviewPreference[]
  memoryConfig                SpaceMemoryConfig?
  secrets                     Secret[]
  chatGroups                  ChatGroup[]
  botSecrets                  BotSecret[]
  botSkillSettings            BotSkillSetting[]
  externalConversations       ExternalConversation[]
  agentSecrets                AgentSecret[]
  board                       Board?
  tickets                     Ticket[]
  ticketComments              TicketComment[]
  companyEntities             CompanyEntity[]
  companyEdges                CompanyEdge[]
  companyEvents               CompanyEvent[]
  companyEventEntities        CompanyEventEntity[]
  companyEvidence             CompanyEvidence[]
  companyIdentities           CompanyIdentity[]
  companyCandidates           CompanyCandidate[]
  companyCorrections          CompanyCorrection[]
  companyRejections           CompanyRejection[]
  companyMerges               CompanyMerge[]
  companyImportRuns           CompanyImportRun[]
  companyImportSources        CompanyImportSource[]
  companyImportUnits          CompanyImportUnit[]
  companyImportCalls          CompanyImportCall[]
  companySourceBlocks         CompanySourceBlock[]
  companyRefreshSources       CompanyRefreshSource[]
  companyCandidateResolutions CompanyCandidateResolution[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([createdByUserId])
  @@map("spaces")
}

model SpaceMember {
  id               String                 @id
  spaceId          String
  organizationId   String
  space            Space                  @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId           String
  member           Member                 @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  role             String                 @default("member")
  createdAt        DateTime
  modelPreferences SpaceModelPreference[]
  voicePreferences SpaceVoicePreference[]
  aiDataConsents   AiDataConsent[]
  backupModels     SpaceBackupModel[]
  dataRoomPrefs    DataRoomPreference?
  companyEntities CompanyEntity[]
  companyEdges    CompanyEdge[]
  companyEvents   CompanyEvent[]
  companyEventEntities CompanyEventEntity[]
  companyEvidence CompanyEvidence[]
  companyIdentities CompanyIdentity[]
  companyCandidates CompanyCandidate[]
  companyCorrections CompanyCorrection[]
  companyRejections CompanyRejection[]
  companyMerges   CompanyMerge[]
  companyImportRuns CompanyImportRun[] @relation("CompanyImportRunOwner")
  companyImportSources CompanyImportSource[] @relation("CompanyImportSourceOwner")
  companyImportUnits CompanyImportUnit[] @relation("CompanyImportUnitOwner")
  companyImportCalls CompanyImportCall[] @relation("CompanyImportCallOwner")
  companySourceBlocks CompanySourceBlock[]
  companyRefreshSources CompanyRefreshSource[] @relation("CompanyRefreshSourceOwner")
  companyCandidateResolutions CompanyCandidateResolution[] @relation("CompanyCandidateResolutionOwner")

  @@unique([spaceId, userId])
  @@index([organizationId, userId])
  @@index([userId, createdAt])
  @@map("space_members")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model DeploymentSettings {
  id                              String   @id @default("default")
  ownerUserId                     String?
  signupsEnabled                  Boolean  @default(true)
  signupAllowlist                 String   @default("")
  signupPolicyInitialized         Boolean  @default(false)
  defaultModelProvider            String?
  defaultModelId                  String?
  deploymentModelCredentialCipher String?
  computerHost                    String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("deployment_settings")
}

model UserModelCredential {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  label          String
  secretId       String
  supportsImages Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  preferences    SpaceModelPreference[]
  creditPauses   ModelConnectionPause[]

  @@unique([id, userId])
  @@index([userId, provider, updatedAt])
  @@map("user_model_credentials")
}

/// The provider said this connection's account is out of credit, so routines on it in this space
/// skip their occurrences until `pausedUntil`. A run on the connection that gets through deletes it.
model ModelConnectionPause {
  spaceId      String
  space        Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String
  credentialId String
  credential   UserModelCredential  @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  pausedUntil  DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  routines     Routine[]

  @@id([spaceId, userId, credentialId])
  @@index([credentialId])
  @@map("model_connection_pauses")
}

model UserVoiceCredential {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  secretId    String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  preferences SpaceVoicePreference[]

  @@unique([id, userId])
  @@index([userId, provider, updatedAt])
  @@map("user_voice_credentials")
}

/// The provider that transcribes this user's dictation. Separate from the voice credential, so a
/// transcription-only provider never changes speech.
model TranscriptionSelection {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  secretId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transcription_selections")
}

model SpaceModelPreference {
  id             String              @id @default(cuid())
  spaceId        String
  userId         String
  spaceMember    SpaceMember         @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  credentialId   String
  credential     UserModelCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  modelId        String?
  thinkingLevel  String?
  /// Embedding model for the Data room, served by this credential's connection. Null: keyword search only.
  embeddingModel String?
  isDefault      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([spaceId, userId, credentialId])
  @@index([spaceId, userId, isDefault, updatedAt])
  @@index([credentialId])
  // Partial unique index space_model_preferences_default_key is created in SQL.
  @@map("space_model_preferences")
}

model SpaceBackupModel {
  spaceId     String
  userId      String
  spaceMember SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  provider    String
  modelId     String
  position    Int

  @@id([spaceId, userId, position])
  @@unique([spaceId, userId, provider, modelId])
  @@map("space_backup_models")
}

model SpaceVoicePreference {
  id           String              @id @default(cuid())
  spaceId      String
  userId       String
  spaceMember  SpaceMember         @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  credentialId String
  credential   UserVoiceCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  voiceId      String              @default("")
  // Fish speech-model override. Null keeps the deployment default.
  speechModel  String?
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([spaceId, userId, credentialId])
  @@index([spaceId, userId, isDefault, updatedAt])
  @@index([credentialId])
  // Partial unique index space_voice_preferences_default_key is created in SQL.
  @@map("space_voice_preferences")
}

model Bot {
  actionApprovalRules    ActionApprovalRule[]
  scratchpadApprovals    ScratchpadApproval[]
  screenGeneration       Int                   @default(0)
  mailSearches           MailSearch[]
  id                     String                @id @default(cuid())
  spaceId                String
  space                  Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId                 String
  name                   String
  title                  String                @default("")
  description            String                @default("")
  instructions           String                @default("")
  color                  String
  notifyOnFinish         Boolean               @default(true)
  pinned                 Boolean               @default(false)
  position               Int                   @default(0)
  sectionId              String?
  section                BotSection?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  archivedAt             DateTime?
  /// Left out of the sidebar chat list by the person; the bot keeps working.
  hiddenAt               DateTime?
  parentBotId            String?
  spawnKey               String?
  // sha256 of the default system prompt the owner chose to keep their own text over; a new default shows the upgrade notice again.
  instructionsUpgradeDismissedHash String?
  memoryScope            String?
  parent                 Bot?                  @relation("BotChildren", fields: [parentBotId], references: [id], onDelete: SetNull)
  children               Bot[]                 @relation("BotChildren")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  thread                 Thread?
  computerId             String?
  computer               Computer?             @relation(fields: [computerId], references: [id], onDelete: SetNull)
  computerSwitching      Boolean               @default(false)
  voiceId                String?
  autoSpeak              Boolean               @default(false)
  modelProvider          String?
  modelId                String?
  // The connection this bot's model runs on; null follows the space default. A plain column, not
  // a foreign key: an automatic sign-out deletes the credential and the pin must survive it, so
  // the run fails by name instead of quietly using another connection.
  modelCredentialId      String?
  thinkingLevel          String?
  disabledBuiltinTools   String[]              @default([])
  // "internal" (default) or "external": talks to people outside the company. Server-owned; no bot tool reads or sets it.
  audience               String                @default("internal")
  // Agent firewall: treat everything the agent reads as untrusted. Server-owned: only the owner's
  // settings API sets it; no bot tool reads or sets it.
  firewall               Boolean               @default(false)
  // Overrides the owner's space permission level; null follows the space. Server-owned: only the owner's
  // settings API sets it; no bot tool, MCP tool or token reads or sets it.
  permissionLevel        String?
  // Capability ids (packages/core request-access.ts) a firewalled agent may ask to use, each use still on a card. Server-owned: only the owner's answer to a request-access card or settings change it.
  firewallAskCapabilities String[]             @default([])
  // "low", "medium" (default) or "high": how far the agent goes beyond the request. Owner-only; no bot tool sets it and nothing reads it for an approval decision.
  proactivity            String                @default("medium")
  // For an external bot: the internal bots it may message (bot ids; empty means none).
  externalMessageTargets String[]              @default([])
  // For an external bot: whether the browser and computer tools are on. Off unless the owner turns them on.
  externalComputerTools  Boolean               @default(false)
  // Where this bot runs commands; null follows DeploymentSettings.computerHost.
  runsOn                 String?
  webhookSecretId        String?
  teamChatAmbientEnabled Boolean               @default(false)
  teamChatRules          String                @default("")
  crossSpaceCommunication Boolean              @default(false)
  // Local desktop control (docs/local-desktop-control): off by default, owner-only.
  appControlEnabled      Boolean               @default(false)
  // [{ id, name }], max 20.
  appControlApps         Json                  @default("[]")
  appControlHeaded       Boolean               @default(false)
  appControlSnapshots    AppControlSnapshot[]
  routines               Routine[]
  scratchpadItems        ScratchpadItem[]
  threadGoals            ThreadGoal[]
  taughtSkills           TaughtSkill[]
  memoryDocuments        MemoryDocument[]
  pages                  BotPage[]
  pageSources            PageSource[]
  pins                   BotPins?
  agentHome              AgentHome?
  browserProfile         BrowserProfile?
  artifacts              Artifact[]
  tasks                  Task[]
  runs                   Run[]
  steeringMessages       SteeringMessage[]
  mcpServers             BotMcpServer[]
  agentForServers        McpServer[]           @relation("McpServerAgent")
  agentForConnections    Connection[]          @relation("ConnectionAgent")
  connectionAccess       BotConnectionAccess[]
  agentForSources        CapabilityInstall[]   @relation("SourceAgent")
  sourceAccess           BotSourceAccess[]
  groupMembers           ChatGroupMember[]
  botSecrets             BotSecret[]
  skillSettings          BotSkillSetting[]
  assignedTickets        Ticket[]              @relation("TicketAssigneeBot")
  createdTickets         Ticket[]              @relation("TicketCreatorBot")
  ticketComments         TicketComment[]       @relation("TicketCommentAuthorBot")
  contacts               Contact[]

  externalConversations ExternalConversation[]

  meetingHandoffs MeetingHandoff[]

  @@unique([spaceId, spawnKey])
  @@index([spaceId, userId, archivedAt, pinned, updatedAt])
  @@index([sectionId])
  @@index([computerId])
  @@index([parentBotId])
  @@index([modelCredentialId])
  @@map("bots")
}

model BotSection {
  id        String      @id @default(cuid())
  spaceId   String
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int         @default(0)
  collapsed Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  bots      Bot[]
  groups    ChatGroup[]

  @@unique([spaceId, userId, name])
  @@index([spaceId, userId, position, createdAt])
  @@map("bot_sections")
}

model BotDeletion {
  id                String   @id
  spaceId           String
  space             Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name              String
  deletedByUserId   String
  memoriesPreserved Boolean
  deletedAt         DateTime @default(now())

  @@index([spaceId, deletedAt])
  @@map("bot_deletions")
}

model ChatGroup {
  id         String            @id @default(cuid())
  spaceId    String
  space      Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  pinned     Boolean           @default(false)
  sectionId  String?
  section    BotSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  // Null until the user orders it by hand; null groups follow the bots in a folder.
  position   Int?
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  members    ChatGroupMember[]
  thread     Thread?
  artifacts  Artifact[]

  @@index([spaceId, userId, archivedAt, pinned, updatedAt])
  @@index([sectionId])
  @@map("chat_groups")
}

model ChatGroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: NoAction)
  createdAt DateTime  @default(now())

  @@unique([groupId, botId])
  @@index([botId])
  @@map("chat_group_members")
}

model Thread {
  id                          String                @id @default(cuid())
  spaceId                     String
  space                       Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                       String?               @unique
  bot                         Bot?                  @relation(fields: [botId], references: [id], onDelete: Cascade)
  groupId                     String?               @unique
  group                       ChatGroup?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  externalConversationId      String?               @unique
  externalConversation        ExternalConversation? @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)
  userId                      String
  createdAt                   DateTime              @default(now())
  nextEventSeq                Int                   @default(0)
  nextMessageSeq              Int                   @default(0)
  historyCompactedUpToSeq     Int?
  historyCompactionSummary    String?               @db.Text
  historyCompactionGeneration Int                   @default(0)
  unread                      Boolean               @default(false)
  /// Highest message seq the thread's owner has read; -1 before any. Moves forward only, except markUnread.
  lastReadSeq                 Int                   @default(-1)
  /// Set when meeting-source agent text reached this thread (directly or forwarded). Cleared with the thread; meeting-source agents set it again on their next run.
  meetingTaintedAt            DateTime?
  messages                    Message[]
  events                      Event[]
  tasks                       Task[]
  runs                        Run[]
  routines                    Routine[]
  goals                       ThreadGoal[]

  @@index([spaceId])
  @@map("threads")
}

model Message {
  id                    String            @id @default(cuid())
  threadId              String
  thread                Thread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq                   Int
  role                  String
  blocks                Json
  botId                 String?
  replyToMessageId      String?
  replyQuote            String?
  replyTo               Message?          @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies               Message[]         @relation("MessageReplies")
  runId                 String?
  clientNonce           String?
  sourceRuns            Run[]             @relation("RunSourceMessage")
  externalTranscriptFor ExternalMessage?
  steeringMessages      SteeringMessage[]
  createdAt             DateTime          @default(now())

  @@unique([threadId, seq])
  @@unique([threadId, clientNonce])
  @@index([threadId, seq])
  @@index([replyToMessageId])
  @@index([runId, seq])
  @@map("messages")
}

model Event {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  botId     String
  seq       Int
  type      String
  payload   Json
  runId     String?
  createdAt DateTime @default(now())

  @@unique([threadId, seq])
  @@index([spaceId, createdAt])
  @@index([threadId, seq])
  @@index([runId, type, seq])
  @@map("events")
}

model Task {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  prompt    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]

  @@index([spaceId, botId])
  @@map("tasks")
}

model Run {
  id                   String            @id @default(cuid())
  spaceId              String
  space                Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                String
  bot                  Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId             String
  thread               Thread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  taskId               String
  task                 Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId               String
  status               String
  trigger              String
  // Decided once when the run is created (newRunUnattended in core); true when nobody is watching.
  // Defaults to true so a creation path that forgets to set it fails closed.
  unattended           Boolean           @default(true)
  // The prompt carries outside content; calls outside the taint-safe list ask. Never cleared.
  externalTaint        Boolean           @default(false)
  modelProvider        String?
  modelId              String?
  // The routine's connection pin, captured with the model.
  modelCredentialId    String?
  thinkingLevel        String?
  // True when these columns are the model the run must keep. A later attempt
  // may record the model it used in the same columns without setting this.
  modelPinned          Boolean           @default(false)
  error                String?
  leaseOwner           String?
  leaseFence           Int               @default(0)
  leaseExpiresAt       DateTime?
  checkpoint           String?
  // What the run is waiting on before its first tool call (RunPhase in contracts). Requeues
  // also keep their streak here, which the executor's circuit breaker reads.
  phase                Json?
  clientNonce          String?
  sourceMessageId      String?
  sourceMessage        Message?          @relation("RunSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  routineId            String?
  routine              Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  // The failed routine run this run retries. Unique, so a run is retried at most once.
  retryOfRunId         String?           @unique
  startedAt            DateTime?
  completedAt          DateTime?
  botOutcomeReturnedAt DateTime?
  messagingMirroredAt  DateTime?
  teamChatMirroredAt   DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  attempts             Attempt[]
  effects              ExternalEffect[]
  usageRecords         UsageRecord[]
  steeringMessages     SteeringMessage[]
  externalMessage      ExternalMessage?
  /// The thread goal this run works toward, while one is active. Cleared when the goal is deleted.
  goalId               String?
  goal                 ThreadGoal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  /// What a goal run's tool calls returned, for the goal check: [{ id, tool, args, ok, result }], at most 24 KB.
  goalEvidence         Json?
  // Restriction markers, written the moment they are set so a continuation reads them here and
  // not from the capped tool log (which trims). readOutsideContent: a tool result that can carry
  // outside text entered the run. readDesktop: the run listed or read a desktop app.
  readOutsideContent   Boolean           @default(false)
  readDesktop          Boolean           @default(false)
  /// The run's record of what it read is kept in run_fragments (set when the first attempt claims it).
  fragmentRecord       Boolean           @default(false)
  fragments            RunFragment[]

  @@unique([spaceId, clientNonce])
  @@index([status, leaseExpiresAt])
  @@index([status, updatedAt, id])
  @@index([botOutcomeReturnedAt, status])
  @@index([trigger, status, messagingMirroredAt, updatedAt])
  @@index([trigger, status, teamChatMirroredAt, updatedAt])
  @@index([spaceId, botId])
  @@index([botId])
  @@index([taskId])
  @@index([sourceMessageId])
  @@index([threadId, status, createdAt])
  @@index([routineId])
  @@index([goalId])
  @@map("runs")
}

/// Keyed hashes of what a run read, one row per recorded tool result, so a resumed attempt can
/// check outbound text against it. Holds no readable private text; publicWords is public text only.
model RunFragment {
  id          Int      @id @default(autoincrement())
  runId       String
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  fence       Int
  /// First 8 hex of a keyed check value; differs after the server key changes.
  keyId       String
  /// 17-byte entries: one tag byte (public ? 4 : 0 | kind) then a 16-byte hash.
  entries     Bytes
  publicWords String?
  createdAt   DateTime @default(now())

  @@index([runId, id])
  @@map("run_fragments")
}

model SteeringMessage {
  id            String    @id @default(cuid())
  messageId     String
  message       Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  botId         String
  bot           Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId        String
  runId         String?
  run           Run?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Set when a pending row must resume as this trigger so its reply can be delivered.
  originTrigger String?
  /// The model's full text when the visible bubble is only a label, such as an inbound delivery.
  prompt        String?
  /// The routine a queued inbound delivery belongs to; its continuation run names it.
  routineId     String?
  /// The mode the queued delivery's trigger implies, carried onto its continuation run.
  unattended    Boolean?
  externalTaint Boolean?
  /// Model agreed for an inbound delivery that had to wait. Empty follows the bot.
  modelProvider String?
  modelId       String?
  modelCredentialId String?
  thinkingLevel String?
  claimedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([messageId, botId])
  @@index([botId, runId, createdAt])
  @@index([runId])
  @@map("steering_messages")
}

model Attempt {
  id         String    @id @default(cuid())
  runId      String
  run        Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  fence      Int
  status     String
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([runId])
  @@map("attempts")
}

// Deliberately independent of chat/user cascades: the worker must still be able
// to cancel remote work after its originating chat or account is deleted.
model CloudAgent {
  id                  String    @id @default(uuid())
  operationKey        String    @unique
  providerKey         String
  spaceId             String
  userId              String
  botId               String
  threadId            String
  messageId           String?
  remoteId            String?
  latestRunId         String?
  title               String
  status              String    @default("running")
  url                 String    @default("")
  branch              String?
  prUrl               String?
  launchRequest       Json
  launchDispatched    Boolean   @default(false)
  followup            Json?
  followupDispatching Boolean   @default(false)
  cancelRequested     Boolean   @default(false)
  generation          Int       @default(0)
  wakeGeneration      Int       @default(-1)
  version             Int       @default(0)
  leaseToken          String?
  leaseExpiresAt      DateTime?
  nextPollAt          DateTime? @default(now())
  errorCount          Int       @default(0)
  createdAt           DateTime  @default(now())

  @@index([providerKey, nextPollAt])
  @@index([spaceId, userId, id])
  @@map("cloud_agents")
}

model ExternalEffect {
  id             String   @id @default(cuid())
  spaceId        String
  space          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  runId          String
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind           String
  idempotencyKey String
  status         String
  request        Json
  result         Json?
  reviewDecision String?
  reviewReason   String?
  reviewModel    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mailReplyItems MailReplyItem[]

  @@unique([idempotencyKey])
  @@index([runId, status])
  @@map("external_effects")
}

model Routine {
  id              String    @id @default(cuid())
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId           String
  bot             Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId          String
  threadId        String?
  thread          Thread?   @relation(fields: [threadId], references: [id], onDelete: SetNull)
  name            String
  prompt          String
  crons           String[]
  timezone        String    @default("UTC")
  active          Boolean   @default(false)
  notify          Boolean   @default(true)
  webhookEnabled  Boolean   @default(false)
  githubEnabled   Boolean   @default(false)
  messageProvider String?
  modelProvider   String?
  modelId         String?
  // Pins the routine's own model to one of the owner's connections.
  modelCredentialId String?
  thinkingLevel   String?
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  /// Runs in a row the model provider refused for the account; each one spaces out the schedule.
  accountFailures Int       @default(0)
  /// The out-of-credit connection that held this routine's last occurrence; shown while that pause lasts.
  pausedConnectionId String?
  connectionPause    ModelConnectionPause? @relation(fields: [spaceId, userId, pausedConnectionId], references: [spaceId, userId, credentialId], onDelete: SetNull)
  /// Server adds silent-reply guidance; a quiet run that says nothing shows "Nothing to report".
  quiet           Boolean   @default(false)
  /// WatchSpecSchema JSON ({ kind: "page", url, intervalMinutes }) or null.
  watch           Json?
  /// "check_in" marks the one managed check-in routine per bot; its crons/active are the bot's check-in setting.
  managedKind     String?
  /// Runs the skill's current playbook instead of `prompt`; null when the skill is deleted.
  taughtSkillId   String?
  taughtSkill     TaughtSkill? @relation(fields: [taughtSkillId], references: [id], onDelete: SetNull)
  watchState      RoutineWatchState?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// When `prompt` last changed (updatedAt also moves with every schedule update); null reads as createdAt.
  promptUpdatedAt DateTime?
  runs            Run[]
  approvalRules   ActionApprovalRule[]

  @@index([active, nextRunAt])
  @@index([spaceId, botId])
  @@index([taughtSkillId])
  @@index([modelCredentialId])
  @@map("routines")
}

/// Probe state for a page watch, one row per watching routine.
model RoutineWatchState {
  routineId         String    @id
  routine           Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  spaceId           String
  space             Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  fingerprint       String?
  /// Normalized page text, at most 16 KB (enforced in code).
  snapshot          String?
  lastCheckedAt     DateTime?
  lastChangedAt     DateTime?
  consecutiveErrors Int       @default(0)
  nextCheckAt       DateTime?
  /// "errors" | "noisy" | "budget" | "access"
  pausedReason      String?
  wakesToday        Int       @default(0)
  /// YYYY-MM-DD in the routine's time zone.
  wakesDay          String?
  /// A change was seen but not yet delivered to the model (daily budget or a wake in flight).
  pendingChange     Boolean   @default(false)
  /// Last 10 check outcomes, 1 changed / 0 same, oldest first.
  recentChanges     Int[]

  @@index([nextCheckAt])
  @@index([spaceId])
  @@map("routine_watch_states")
}

model ScratchpadItem {
  id           String    @id @default(cuid())
  spaceId      String
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId        String
  bot          Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId       String
  title        String
  status       String    @default("open")
  notes        String    @default("")
  category     String?
  channel      String?
  target       String?
  scheduledFor DateTime?
  proof        String?
  approvedAt   DateTime?
  approvedBy   String?
  /// When the item is due. Not scheduledFor, which is a GTM post time.
  dueAt        DateTime?
  waitingOn    String?
  resolvedReason String?
  /// Set when the item tracks a mail thread. Deleting the connection drops the link, not the item.
  mailConnectionId String?
  mailConnection   Connection? @relation(fields: [mailConnectionId], references: [id], onDelete: SetNull)
  mailThreadId     String?
  /// The provider message id mail_get takes.
  mailMessageId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([spaceId, botId, status])
  @@index([spaceId, botId, status, dueAt])
  @@index([mailConnectionId])
  // Partial unique index scratchpad_items_open_mail_thread_key is created in SQL.
  @@index([spaceId, botId, updatedAt])
  @@map("scratchpad_items")
}

model ScratchpadApproval {
  id         String   @id @default(cuid())
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId      String
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  // Deliberately not a foreign key: discarding or expiring an item must not reset quota.
  itemId     String
  category   String
  channel    String
  approvedBy String
  approvedAt DateTime @default(now())

  @@index([spaceId, userId, botId, category, channel, approvedBy, approvedAt], map: "scratchpad_approvals_scope_window_idx")
  @@map("scratchpad_approvals")
}

model TaughtSkill {
  id        String    @id @default(cuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  name      String    @default("")
  goal      String
  status    String
  playbook  Json      @default("{}")
  recording Json      @default("{\"events\":[],\"snapshots\":[]}")
  startedAt DateTime?
  expiresAt DateTime?
  stoppedAt DateTime?
  /// Stamped when a chat, routine or test run uses the skill.
  lastRunAt DateTime?
  /// The card's latest Test run, and its outcome ("worked" | "stopped") once that run has ended.
  lastTestRunId   String?
  lastTestOutcome String?
  lastTestNote    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// When `playbook` last changed (updatedAt also moves on every run); null reads as createdAt.
  playbookUpdatedAt DateTime?
  routines   Routine[]
  heldValues TeachHeldValue[]

  @@index([spaceId, botId])
  @@index([spaceId, botId, status])
  // Partial unique index taught_skills_botId_recording_key is created in SQL:
  // one recording session per bot.
  @@map("taught_skills")
}

/// A value typed into a password field while teaching, held (encrypted like a BotSecret) until
/// the user saves it as a login or skips it. Deleted on save, skip, cancel, delete and after 30 minutes.
model TeachHeldValue {
  id         String      @id @default(cuid())
  skillId    String
  skill      TaughtSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  spaceId    String
  userId     String
  segment    Int
  /// The playbook step that stands for this value; set when recording stops.
  stepIndex  Int?
  field      String      @default("")
  ciphertext String
  expiresAt  DateTime
  createdAt  DateTime    @default(now())

  @@unique([skillId, segment])
  @@index([expiresAt])
  @@map("teach_held_values")
}

/// Claude Agent Skills: SKILL.md recipes shared across assistants (not per-bot).
/// The Pi runtime already understands this format; we persist and inject them.
/// Distinct from TaughtSkill (demo/record playbooks).
model AgentSkill {
  id             String   @id @default(cuid())
  spaceId        String
  space          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId         String
  name           String
  description    String
  content        String
  /// user | builtin | plugin — only user skills are writable via API/tools.
  source         String   @default("user")
  /// user | agent — who wrote it. Agent-written skills need the owner's approval.
  origin         String   @default("user")
  /// active | draft — a draft is in no catalog until the owner approves it.
  status         String   @default("active")
  /// An agent's proposed full SKILL.md for an active skill, applied when the owner approves.
  pendingContent String?
  /// A bot-built tool: one self-contained JavaScript source defining `function run(input)`, run in the
  /// QuickJS sandbox by tool_run. Null for an ordinary skill.
  toolSource      String?
  /// The tool's input schema (the subset validated by validateToolInputSchema).
  toolInputSchema Json?
  /// sha256 of the toolSource the owner approved. Null for a draft; tool_run refuses an active
  /// tool whose source no longer matches.
  toolSourceHash  String?
  /// What the bot said about the tool, shown beside Approve: { reads, writes, sampleInput, sampleOutput }.
  toolNotes       Json?
  /// An agent's proposed replacement { source, inputSchema, notes } for an active tool, applied (and
  /// hashed) only when the owner approves. The running source stays as it was until then.
  pendingTool     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([spaceId, userId])
  // Case-insensitive unique index agent_skills_spaceId_userId_name_lower_key is created in SQL.
  @@map("agent_skills")
}

/// Per-bot switch for one skill. No row means on. skillKey is an AgentSkill id or `builtin:<name>`.
model BotSkillSetting {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  skillKey  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([botId, skillKey])
  @@index([spaceId])
  @@map("bot_skill_settings")
}

/// A saved mail_search result, readable by mail_grep until `expiresAt`. Scoped to one bot of one user.
model MailSearch {
  id        String          @id @default(cuid())
  spaceId   String
  space     Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot             @relation(fields: [botId], references: [id], onDelete: Cascade)
  /// The object mail_search returned, minus searchId.
  summary   Json
  /// [{ accountId, query, unhydratedIds, pageToken? }] for queries that stopped early; null when complete.
  resume    Json?
  createdAt DateTime        @default(now())
  expiresAt DateTime
  rows      MailSearchRow[]

  @@index([spaceId, userId, botId])
  @@index([expiresAt])
  @@map("mail_searches")
}

model MailSearchRow {
  searchId String
  search   MailSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  /// 1-based, oldest first.
  line     Int
  /// ISO 8601, so the ISO-prefix date filter is a string comparison.
  date     String
  /// The row line, at most about 4,500 characters.
  text     String

  @@id([searchId, line])
  @@map("mail_search_rows")
}

model Connection {
  id                  String                @id @default(cuid())
  spaceId             String
  space               Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId              String
  connectorId         String                @default("composio")
  provider            String
  displayName         String
  status              String
  secretId            String?
  providerRef         String?
  metadata            Json                  @default("{}")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  cachedMailMessages  CachedMailMessage[]
  mailSenderStats     MailSenderStat[]
  mailSenderDecisions MailSenderDecision[]
  mailActionLogs      MailActionLog[]
  inboxTodos          InboxTodo[]
  scratchpadItems     ScratchpadItem[]
  meetings            Meeting[]
  meetingSyncState    MeetingSyncState?
  mailSyncState       MailSyncState?
  contactPhotoSync    ContactPhotoSync?
  dataRoomSyncState   DataRoomSyncState?
  dataRoomItems       DataRoomItem[]
  composeSends        ComposeSend[]
  mailReplyItems      MailReplyItem[]
  /// false: only bots with a BotConnectionAccess row may use this connection's tools.
  allAgents           Boolean               @default(true)
  /// Agent-linked connection: other agents may be given access. Stays true while every other agent is off.
  agentShared         Boolean               @default(false)
  botAccess           BotConnectionAccess[]
  writesEnabled       Boolean               @default(false)
  agentBotId          String?
  agentBot            Bot?                  @relation("ConnectionAgent", fields: [agentBotId], references: [id], onDelete: SetNull)
  /// Set once, when begin creates a brand-new row (never on reuse, never cleared): the connection
  /// is private to its own agent from the start, stays private when the agent goes away, and is
  /// always scoped on its own. Older rows keep the shared-by-default rules.
  privateByDefault    Boolean               @default(false)
  companyEvidence     CompanyEvidence[]
  companyCandidates   CompanyCandidate[]    @relation("CompanyCandidateConnection")
  omiUploads          OmiUpload[]
  omiSegments         OmiSegment[]

  @@index([spaceId, userId, connectorId])
  @@unique([id, spaceId, userId])
  @@index([agentBotId])
  @@map("connections")
}

/// One piece of records a pendant uploaded, kept raw until the assemble job turns it into recordings.
model OmiUpload {
  id           String     @id @default(cuid())
  spaceId      String
  space        Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Sequence number of the first 444-byte record.
  firstSeq     BigInt
  /// SHA-256 (hex) of the body. A retry repeats both; a restarted counter repeats only firstSeq.
  sha256       String
  recordCount  Int
  /// Omi codec byte: 20 (10 ms frames) or 21 (20 ms frames).
  codec        Int
  rtcValid     Boolean
  receivedAt   DateTime   @default(now())
  /// The raw bytes in the artifact store; removed once assembled.
  storageKey   String
  assembledAt  DateTime?

  @@unique([connectionId, firstSeq, sha256])
  @@index([connectionId, assembledAt])
  @@map("omi_uploads")
}

/// One sorted stretch of an Omi recording: a meeting, a note or trash.
model OmiSegment {
  id           String       @id @default(cuid())
  spaceId      String
  space        Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String
  connectionId String
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  audioItemId  String
  audioItem    DataRoomItem @relation("OmiSegmentAudio", fields: [audioItemId], references: [id], onDelete: Cascade)
  /// Seconds from the start of the recording.
  start        Int
  end          Int
  /// "meeting", "note" or "trash".
  kind         String
  title        String
  meetingId    String?
  meeting      Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  noteItemId   String?
  noteItem     DataRoomItem? @relation("OmiSegmentNote", fields: [noteItemId], references: [id], onDelete: SetNull)
  /// "agent" or "user"; a re-sort never changes a user's choice.
  sortedBy     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([audioItemId, start])
  @@index([spaceId, userId, createdAt])
  @@map("omi_segments")
}

model BotConnectionAccess {
  id           String     @id @default(cuid())
  spaceId      String
  userId       String
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  botId        String
  bot          Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  /// Firewalled agents: the Gmail label this agent may read. Null means the whole connection.
  supportLabel String?
  /// Besides reading, this agent may make changes (each still asks the owner) while the connection's changes switch is on.
  canWrite     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([connectionId, botId])
  @@index([botId])
  @@map("bot_connection_access")
}

model CapabilityInstall {
  id            String            @id @default(cuid())
  spaceId       String
  space         Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId        String
  kind          String
  name          String
  source        String
  version       String?
  digest        String?
  secretId      String?
  config        Json              @default("{}")
  createdAt     DateTime          @default(now())
  /// The source's own agent (MCP, API and GraphQL sources). Cleared if the bot is deleted.
  agentBotId    String?
  agentBot      Bot?              @relation("SourceAgent", fields: [agentBotId], references: [id], onDelete: SetNull)
  /// Every internal agent may use the source. New sources start false: private to their own agent.
  allAgents     Boolean           @default(false)
  /// Other agents may be given access. Stays true while every other agent is off.
  agentShared   Boolean           @default(false)
  /// Agents may make changes (each change still asks); a non-owner needs its own canWrite grant unless allAgents.
  writesEnabled Boolean           @default(false)
  botAccess     BotSourceAccess[]

  @@index([spaceId, userId])
  @@map("capability_installs")
}

/// Which agents besides the source's own may use a directly connected source (the shape of BotConnectionAccess).
model BotSourceAccess {
  id        String            @id @default(cuid())
  spaceId   String
  userId    String
  installId String
  install   CapabilityInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  canWrite  Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@unique([installId, botId])
  @@index([botId])
  @@map("bot_source_access")
}

model MemoryDocument {
  id        String           @id @default(cuid())
  spaceId   String
  space     Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  botId     String?
  bot       Bot?             @relation(fields: [botId], references: [id], onDelete: Cascade)
  scope     String
  path      String
  content   String
  revision  Int              @default(1)
  /// "preference", "fact" or "task": how fast recall lets it fade (packages/adapter-kit memory-strength).
  kind      String           @default("fact")
  /// Times a run loaded it into its prompt, and when last; both keep it strong.
  useCount   Int             @default(0)
  lastUsedAt DateTime?
  /// Set when the owner edited it by hand: it never fades.
  pinned     Boolean         @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  revisions MemoryRevision[]

  @@unique([spaceId, scope, botId, path])
  @@index([spaceId, userId])
  @@map("memory_documents")
}

model MemoryRevision {
  id             String         @id @default(cuid())
  documentId     String
  document       MemoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision       Int
  content        String
  sourceRunId    String?
  sourceThreadId String?
  createdAt      DateTime       @default(now())

  @@unique([documentId, revision])
  @@map("memory_revisions")
}

/// A bot's named Markdown pages (up to 20), written by the bot's tools and edited by its owner.
model BotPage {
  id        String            @id @default(cuid())
  spaceId   String
  space     Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  content   String
  /// "blocks" (Markdown with live blocks) or "html" (one sandboxed HTML document). Fixed at creation.
  kind      String            @default("blocks")
  revision  Int               @default(1)
  /// "bot" or "user"
  updatedBy String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  revisions BotPageRevision[]
  sources   PageSource[]
  sidebarPages SidebarPage[]

  // Titles are unique per bot ignoring case: unique index bot_pages_botId_title_key (raw SQL in
  // migration 20261231000026) on (botId, lower(title)).
  @@index([botId])
  @@index([spaceId])
  @@map("bot_pages")
}

/// A saved read-only data call on a bot page. Page blocks name it; the server reruns it without a model and stores each result as a snapshot.
model PageSource {
  id               String               @id @default(cuid())
  spaceId          String
  space            Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// The bot's owner.
  userId           String
  botId            String
  bot              Bot                  @relation(fields: [botId], references: [id], onDelete: Cascade)
  pageId           String
  page             BotPage              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name             String
  /// "praci" for now.
  kind             String
  call             Json
  schedule         String
  /// "pending" | "active" | "paused" | "denied"
  status           String
  nextRefreshAt    DateTime?
  leaseUntil       DateTime?
  failures         Int                  @default(0)
  lastError        String?
  lastRefreshAt    DateTime?
  approvedCallHash String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  snapshots        PageSourceSnapshot[]

  // Names are unique per page ignoring case: unique index page_sources_pageId_name_key (raw SQL in
  // migration 20261231000029) on (pageId, lower(name)).
  @@index([spaceId])
  @@index([status, nextRefreshAt])
  @@map("page_sources")
}

/// Snapshot ids a run's app control produced, so refs stay owned by one run across processes.
model AppControlSnapshot {
  id         String   @id @default(cuid())
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  botId      String
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  runId      String
  snapshotId String
  appId      String
  windowId   String?
  surface    String
  sensitive  Boolean
  spent      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([spaceId, userId, botId, runId, snapshotId])
  @@index([runId])
  @@index([createdAt])
  @@map("app_control_snapshots")
}

/// One successful result of a page source.
model PageSourceSnapshot {
  id        String     @id @default(cuid())
  spaceId   String
  space     Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sourceId  String
  source    PageSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fetchedAt DateTime   @default(now())
  value     Json
  bytes     Int

  @@index([sourceId, fetchedAt(sort: Desc)])
  /// The per-space daily refresh budget counts a space's snapshots since UTC midnight.
  @@index([spaceId, fetchedAt])
  @@map("page_source_snapshots")
}

/// A bot's numbers strip (stats) and one sidebar list; separate from the page so refreshes never conflict with page edits.
model BotPins {
  id          String    @id @default(cuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId       String    @unique
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId      String
  stats       Json
  list        Json?
  revision    Int       @default(1)
  /// "bot" or "user"
  updatedBy   String
  refreshedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([spaceId])
  @@map("bot_pins")
}

model BotPageRevision {
  id          String   @id @default(cuid())
  pageId      String
  page        BotPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  revision    Int
  content     String
  updatedBy   String
  sourceRunId String?
  createdAt   DateTime @default(now())

  @@unique([pageId, revision])
  @@map("bot_page_revisions")
}

model AgentHome {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String   @unique
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  revision  String   @default("empty")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_homes")
}

model BrowserProfile {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String   @unique
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  secretId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("browser_profiles")
}

model ComputerUpdate {
  action     String   @default("update")
  id         String   @id @default(cuid())
  computerId String
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  botId      String
  status     String   @default("queued")
  stage      String   @default("preparing")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([computerId, createdAt])
  @@index([status, updatedAt])
  @@map("computer_updates")
}

model Computer {
  screenGeneration        Int                      @default(0)
  id                      String                   @id @default(cuid())
  spaceId                 String
  space                   Space                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId                  String
  scope                   String                   @default("team")
  scopeKey                String                   @unique
  homeKey                 String                   @unique
  homeRevision            String                   @default("empty")
  homeSnapshotId          String?
  homePreviousSnapshotId  String?
  kind                    String
  providerRef             String?
  state                   String                   @default("stopped")
  controlHolder           String                   @default("none")
  controlLeaseId          String?
  controlLeaseExpiresAt   DateTime?
  controlBotId            String?
  controlRunId            String?
  controlFence            Int                      @default(0)
  executionRunId          String?
  executionBotId          String?
  executionLeaseExpiresAt DateTime?
  executionFence          Int                      @default(0)
  screenUrl               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  bots                    Bot[]
  executionLeases         ComputerExecutionLease[]
  maintenanceId           String?
  updates                 ComputerUpdate[]

  @@index([spaceId, scope])
  @@map("computers")
}

model ComputerExecutionLease {
  id         String   @id @default(cuid())
  computerId String
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  botId      String
  runId      String
  fence      Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([computerId, botId])
  @@index([runId])
  @@index([computerId, expiresAt])
  @@index([botId, expiresAt])
  @@map("computer_execution_leases")
}

model Artifact {
  id          String     @id @default(cuid())
  spaceId     String
  space       Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId       String?
  bot         Bot?       @relation(fields: [botId], references: [id], onDelete: SetNull)
  groupId     String?
  group       ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  runId       String?
  name        String
  description String?
  mimeType    String
  size        Int
  hash        String
  storageKey  String
  createdAt   DateTime   @default(now())

  // Null on the first version; that row's id is the family's stable id.
  rootArtifactId String?
  rootArtifact   Artifact?  @relation("ArtifactVersions", fields: [rootArtifactId], references: [id], onDelete: Cascade)
  versions       Artifact[] @relation("ArtifactVersions")
  shares         ArtifactShare[]
  version        Int        @default(1)
  // Client-chosen per upload so a retried upload that already landed returns this row.
  clientNonce    String?

  @@unique([spaceId, userId, clientNonce])
  @@index([spaceId, botId])
  @@index([groupId])
  @@index([rootArtifactId])
  // artifacts_family_version_key is raw SQL: Prisma cannot express COALESCE indexes.
  @@map("artifacts")
}

/// A view-only public link to one exact artifact version. Only the sha256 of the token is stored.
model ArtifactShare {
  id              String    @id @default(cuid())
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  artifactId      String
  artifact        Artifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  createdByUserId String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  lastOpenedAt    DateTime?
  /// Public opens in the current one-minute window, kept in Postgres so every API process agrees.
  openWindowStart DateTime?
  openCount       Int       @default(0)

  @@index([spaceId, artifactId])
  @@map("artifact_shares")
}

model UsageRecord {
  id                 String   @id @default(cuid())
  spaceId            String
  space              Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Which bot spent this. Deliberately NOT a relation: a usage row is spend that really
  /// happened, and no lifecycle event on the bot may delete it or blank its attribution.
  /// `Cascade` erased the row; `SetNull` would erase the attribution instead, and because
  /// deleting a bot also deletes its runs, `runId` goes null in the same breath — the row
  /// would keep only space, user, model and token counts.
  ///
  /// So the id outlives the bot and may dangle. Read it with a LEFT JOIN; `BotDeletion.id`
  /// IS the bot id, so a deleted bot's name is still reachable for display.
  botId              String?
  userId             String
  runId              String?
  run                Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  provider           String
  model              String
  /// Uncached input; cache buckets are additional, reasoning is a subset of output.
  inputTokens        Int?
  outputTokens       Int?
  cacheReadTokens    Int?
  cacheWriteTokens   Int?
  cacheWrite1hTokens Int?
  reasoningTokens    Int?
  totalTokens        Int?
  costUsd            Float?
  costSource         String?
  pricingVersion     String?
  usageSource        String?
  callId             String?  @unique
  operationId        String?
  operationKind      String   @default("answer")
  /// Durable attribution, deliberately without lifecycle foreign keys.
  parentRunId        String?
  agentId            String?
  createdAt          DateTime @default(now())

  @@index([spaceId, userId, createdAt])
  @@map("usage_records")
}

model NotificationPreference {
  id       String  @id @default(cuid())
  spaceId  String
  space    Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  finish   Boolean @default(true)
  help     Boolean @default(true)
  takeover Boolean @default(true)
  // Per external channel switches, for example {"push": false}. A missing key means enabled.
  channels Json    @default("{}")

  @@unique([spaceId, userId])
  @@map("notification_preferences")
}

enum NotificationImportance {
  info
  attention
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
  skipped
}

// Something an agent tells the user. Scoped to space and user. botId, routineId and runId are
// plain ids so a deleted agent does not delete the history; the 30 day retention removes the rows.
model Notification {
  id         String                 @id @default(cuid())
  spaceId    String
  space      Space                  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId      String?
  routineId  String?
  runId      String?
  surface    String
  threadId   String?
  title      String
  body       String?
  link       String?
  importance NotificationImportance @default(info)
  /// Sidebar status icon: urgent, needs_input, failed, done or new. Null on older rows (falls back to importance).
  kind       String?
  dedupeKey  String
  createdAt  DateTime               @default(now())
  seenAt     DateTime?
  shownAt    DateTime?
  /// The person closed this approval's toast with X; it is no longer restored.
  dismissedAt DateTime?
  deliveries NotificationDelivery[]

  @@index([spaceId, userId, botId, dedupeKey, createdAt])
  @@index([spaceId, userId, seenAt])
  @@index([spaceId, userId, botId, seenAt])
  @@index([spaceId, userId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String
  status         NotificationDeliveryStatus @default(pending)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime
  lastError      String?
  createdAt      DateTime                   @default(now())

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

// Where a channel reaches a user: an Expo push token per device today. spaceId is null for
// account-wide addresses.
model NotificationEndpoint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String?
  space     Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  channel   String
  address   String
  deviceId  String
  sessionId String?
  /// Which push service the address belongs to: "expo" or "apns". Only used by the push channel.
  platform  String   @default("expo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channel, deviceId])
  @@unique([channel, address])
  @@index([sessionId])
  @@map("notification_endpoints")
}

model SpaceMemoryConfig {
  id                 String   @id @default(cuid())
  spaceId            String   @unique
  space              Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId             String
  provider           String
  settings           Json
