  spaceId            String
  space              Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Chosen by the client; makes `start` idempotent per user.
  clientId           String
  title              String?
  /// "device" (text from the client) or "server" (audio transcribed here).
  engine             String
  /// "microphone" and/or "system".
  tracks             String[]
  /// "recording", "finishing", "done", "failed" or "discarded".
  status             String                @default("recording")
  startedAt          DateTime              @default(now())
  endedAt            DateTime?
  lastChunkAt        DateTime?
  consentConfirmedAt DateTime?
  meetingId          String?
  meeting            Meeting?              @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  /// Short reason only; never audio or text.
  error              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  chunks             MeetingCaptureChunk[]

  @@unique([userId, clientId])
  @@index([spaceId, userId, status])
  @@map("meeting_captures")
}

/// One stretch of one track. Audio lives in the artifact store until it is transcribed.
model MeetingCaptureChunk {
  id        String         @id @default(cuid())
  spaceId   String
  space     Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  captureId String
  capture   MeetingCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  /// "microphone" or "system".
  track     String
  seq       Int
  startMs   Int
  endMs     Int
  sha256    String
  blobKey   String?
  text      String?
  /// "pending", "done" or "failed".
  status    String         @default("pending")
  attempts  Int            @default(0)
  createdAt DateTime       @default(now())

  @@unique([captureId, track, seq])
  @@map("meeting_capture_chunks")
}

/// One row on a pipeline: a firm or person being raised from, with zero or more linked contacts.
model PipelineRecord {
  id                  String    @id @default(cuid())
  spaceId             String
  space               Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "fundraising" for now.
  pipeline            String    @default("fundraising")
  name                String
  /// Lowercase letters and digits of the name; two records can never be the same firm.
  normalizedName      String
  /// A PipelineStatus.
  status              String    @default("not_reached")
  statusBeforePassed  String?
  /// The investor's stance: "in", "maybe" or "out". Never touches money.
  interest            String?
  referredByContactId String?
  referredBy          Contact?  @relation("PipelineRecordReferrer", fields: [referredByContactId, spaceId, userId], references: [id, spaceId, userId], onDelete: SetNull)
  amountCents         BigInt?
  nextStep            String?
  nextCallAt          DateTime?
  nextCallHasTime     Boolean   @default(false)
  /// Latest mail either way, or past meeting, with one of the record's people; set by the auto-status job.
  lastContactAt       DateTime?
  /// When Send SAFE opened Mercury; null when not waiting for a Mercury SAFE.
  waitingSince        DateTime?
  /// The round open when the status was last saved as committed; null otherwise.
  roundId             String?
  round               FundraiseRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  /// [{label, value, source: list|agent|owner, url?, at}]
  details             Json      @default("[]")
  /// A list's priority tier, such as "Wave 2".
  group               String?
  /// A list's row order; breaks ties when sorting.
  listOrder           Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  people              PipelineRecordPerson[]
  events              PipelineEvent[]

  @@unique([spaceId, userId, pipeline, normalizedName])
  @@unique([id, spaceId, userId, pipeline])
  @@unique([id, spaceId, userId])
  @@index([roundId])
  @@index([referredByContactId])
  @@map("pipeline_records")
}

/// A contact on a record. A contact sits in one record per pipeline; at most one person per record is primary (partial unique index in the migration).
model PipelineRecordPerson {
  id        String         @id @default(cuid())
  spaceId   String
  userId    String
  pipeline  String         @default("fundraising")
  recordId  String
  record    PipelineRecord @relation(fields: [recordId, spaceId, userId, pipeline], references: [id, spaceId, userId, pipeline], onDelete: Cascade)
  contactId String
  contact   Contact        @relation(fields: [contactId, spaceId, userId], references: [id, spaceId, userId], onDelete: Cascade)
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@unique([spaceId, userId, pipeline, contactId])
  @@index([recordId])
  @@map("pipeline_record_people")
}

/// One entry on a record's timeline.
model PipelineEvent {
  id       String         @id @default(cuid())
  spaceId  String
  userId   String
  recordId String
  record   PipelineRecord @relation(fields: [recordId, spaceId, userId], references: [id, spaceId, userId], onDelete: Cascade)
  /// "call" | "note" | "status" | "interest" | "invite" | "import" | "auto"
  kind     String
  /// "user" or a bot id.
  actor    String         @default("user")
  at       DateTime       @default(now())
  payload  Json           @default("{}")

  @@index([recordId, at])
  @@map("pipeline_events")
}

/// One list import, reviewed on one card. At most one is open per user (partial unique index in the migration).
model PipelineImport {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipeline  String   @default("fundraising")
  /// "staging" | "reviewing" | "applying" | "done" | "discarded"
  status    String   @default("staging")
  /// The run that started it; another run's `start` discards it, a retry of this one does not.
  runId     String?
  /// The agent that staged it, for "added by" on its new contacts.
  botId     String?
  /// The external effect of its latest card.
  effectId  String?
  /// Contacts this import made so far, by person key, so two rows naming one person share one.
  created   Json     @default("{}")
  /// The PipelineImportResult, once done.
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rows      PipelineImportRow[]

  @@unique([id, spaceId, userId])
  @@index([spaceId, userId])
  @@index([status, updatedAt])
  @@map("pipeline_imports")
}

/// One firm of a list import.
model PipelineImportRow {
  id             String         @id @default(cuid())
  spaceId        String
  userId         String
  importId       String
  import         PipelineImport @relation(fields: [importId, spaceId, userId], references: [id, spaceId, userId], onDelete: Cascade)
  position       Int
  normalizedFirm String
  /// A PipelineImportRow. On an import closed by migration 20261231000057, whatever the old column held.
  data           Json
  /// "staged" | "queued" | "applied" | "skipped" | "unchanged" | "failed"
  state          String         @default("staged")
  /// The answered decisions the worker applies.
  plan           Json?
  /// What applying it did, for the result.
  outcome        Json?
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([importId, normalizedFirm])
  @@unique([importId, position])
  @@index([importId, state, position])
  @@map("pipeline_import_rows")
}

/// What the owner asked a bot to keep working toward in its own thread (`/goal`). At most one is
/// open (active or paused) per thread; the partial unique index thread_goals_one_open_key is in SQL.
model ThreadGoal {
  id               String    @id @default(cuid())
  spaceId          String
  space            Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId           String
  threadId         String
  thread           Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  botId            String
  bot              Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  text             String
  /// active | paused | met | blocked | stopped | cleared
  status           String
  /// runs | time | spend | stalled | owner | check_failed | model_error
  stopReason       String?
  continuations    Int       @default(0)
  stalls           Int       @default(0)
  lastCheckedRunId String?
  /// { verdict, reason, evidence, next }
  lastVerdict      Json?
  /// Reset when a paused goal resumes.
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  runs             Run[]

  @@index([threadId, status])
  @@map("thread_goals")
}

// ==== Cap table ledger (Equity*) ===========================================================
// Foundation section. Areas append their own fields and models in a marked block below this one.
// Every Equity row belongs to one EquityLedger (spaceId, userId); the composite relations keep a
// row and what it points at in the same ledger. Money is integer cents (BigInt), share counts are
// BigInt, prices and ratios are Decimal. Enumerated values are listed in packages/contracts/src/equity.

/// One cap table ledger per user in a space: the root every Equity row hangs off.
model EquityLedger {
  id              String    @id @default(cuid())
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When the snapshot was copied in (once); null for a ledger started empty or from CSV.
  importedAt      DateTime?
  /// securities area: the SAFE funding the board approved, in cents; null until set.
  safeBoardApprovedCents BigInt?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stakeholders          EquityStakeholder[]
  stakeholderProperties EquityStakeholderProperty[]
  customProperties      EquityCustomProperty[]
  shareClasses          EquityShareClass[]
  shareClassVersions    EquityShareClassVersion[]
  plans                 EquityPlan[]
  vestingTemplates      EquityVestingTemplate[]
  vestingSchedules      EquityVestingSchedule[]
  certificates          EquityCertificate[]
  convertibleBlocks     EquityConvertibleBlock[]
  convertibles          EquityConvertible[]
  optionGrants          EquityOptionGrant[]
  exercises             EquityExercise[]
  transactions          EquityTransaction[]
  draftSets             EquityDraftSet[]
  fundingRounds         EquityFundingRound[]
  savedViews            EquitySavedView[]
  accessGroups          EquityAccessGroup[]
  accessGrants          EquityAccessGrant[]
  healthFindings        EquityHealthFinding[]
  // views area
  roundScenarios        EquityRoundScenario[]
  viewsSettings         EquityViewsSettings?
  reportRuns            EquityReportRun[]
  // stakeholders area
  stakeholderChanges    EquityStakeholderChange[]
  hrisPreferences       EquityHrisPreferences?
  warrants              EquityWarrant[]
  // access area
  documentLinks         EquityDocumentLink[]
  auditEvents           EquityAuditEvent[]

  @@unique([spaceId, userId])
  @@map("equity_ledgers")
}

/// A holder: a person or an organization (a firm, fund or trust).
model EquityStakeholder {
  id               String       @id @default(cuid())
  spaceId          String
  userId           String
  ledger           EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// individual | organization
  type             String
  /// Display name: "First Last" for a person, the one name for an organization.
  name             String
  firstName        String?
  lastName         String?
  /// The company-entered contact email.
  contactEmail     String?
  /// The holder's login; locked once the holder accepts a security (portfolioEmailLockedAt).
  portfolioEmail   String?
  portfolioEmailLockedAt DateTime?
  /// More addresses the company keeps for the holder.
  otherEmails      String[]     @default([])
  dateOfBirth      DateTime?    @db.Date
  taxId            String?
  employeeId       String?
  payrollId        String?
  /// [{ country, street, city, state, postalCode }], first is the primary address.
  addresses        Json         @default("[]")
  /// The current relationship, job title, cost center and department: the latest dated property of
  /// each kind on or before today, kept in step by the store so the list can sort and filter.
  relationship     String?
  jobTitle         String?
  costCenter       String?
  department       String?
  /// { [EquityCustomProperty.id]: string }
  customValues     Json         @default("{}")
  /// A firm this fund rolls up to.
  parentId         String?
  parent           EquityStakeholder?  @relation("EquityStakeholderParent", fields: [parentId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  children         EquityStakeholder[] @relation("EquityStakeholderParent")
  warrants         EquityWarrant[]
  contactId        String?
  /// The database foreign key is ON DELETE SET NULL ("contactId") (migration 107, Postgres 15+), which Prisma cannot express. Do not trust `prisma migrate diff` on it.
  contact          Contact?     @relation(fields: [contactId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  majorInvestor    Boolean      @default(false)
  terminatedAt     DateTime?    @db.Date
  /// Set when merged into another stakeholder; the row stays readable.
  mergedIntoId     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  properties       EquityStakeholderProperty[]
  certificates     EquityCertificate[]
  convertibles     EquityConvertible[]
  optionGrants     EquityOptionGrant[]
  accessGrant      EquityAccessGrant?
  stakeholderChanges EquityStakeholderChange[]
  documentLinks    EquityDocumentLink[]

  /// Client idempotency key and a hash of the request, so a retry replays the first create.
  requestKey String? @db.Uuid
  requestHash String?
  @@unique([id, spaceId, userId])
  @@index([spaceId, userId, name])
  @@index([spaceId, userId, relationship])
  @@unique([spaceId, userId, contactId])
  @@unique([spaceId, userId, requestKey])
  @@map("equity_stakeholders")
}

/// One dated value of a stakeholder property: relationship, job title, cost center or department.
model EquityStakeholderProperty {
  id            String            @id @default(cuid())
  spaceId       String
  userId        String
  ledger        EquityLedger      @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  stakeholderId String
  stakeholder   EquityStakeholder @relation(fields: [stakeholderId, spaceId, userId], references: [id, spaceId, userId], onDelete: Cascade)
  /// relationship | job_title | cost_center | department
  kind          String
  effectiveDate DateTime          @db.Date
  value         String
  createdAt     DateTime          @default(now())

  @@index([stakeholderId, kind, effectiveDate])
  @@map("equity_stakeholder_properties")
}

/// A company-defined stakeholder property; values live on EquityStakeholder.customValues.
model EquityCustomProperty {
  id        String       @id @default(cuid())
  spaceId   String
  userId    String
  ledger    EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  name      String
  /// The HRIS field it maps to, when any.
  hrisField String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([spaceId, userId, name])
  @@map("equity_custom_properties")
}

/// A share class. Its terms are versioned by incorporation document date (EquityShareClassVersion).
model EquityShareClass {
  id        String       @id @default(cuid())
  spaceId   String
  userId    String
  ledger    EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  name      String
  /// Used in security labels, e.g. CS, PS, PSP.
  prefix    String
  /// common | preferred
  classType String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  versions     EquityShareClassVersion[]
  certificates EquityCertificate[]
  plans        EquityPlan[]
  optionGrants EquityOptionGrant[] @relation("EquityOptionGrantShareClass")
  convertibles EquityConvertible[]
  warrants     EquityWarrant[]

  @@unique([id, spaceId, userId])
  @@unique([spaceId, userId, name])
  @@unique([spaceId, userId, prefix])
  @@map("equity_share_classes")
}

/// A share class's terms as of one incorporation document date. The latest is the current version.
model EquityShareClassVersion {
  id                    String           @id @default(cuid())
  spaceId               String
  userId                String
  ledger                EquityLedger     @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  shareClassId          String
  shareClass            EquityShareClass @relation(fields: [shareClassId, spaceId, userId], references: [id, spaceId, userId], onDelete: Cascade)
  /// The incorporation document (charter) date these terms come from.
  documentDate          DateTime         @db.Date
  authorizedShares      BigInt
  votesPerShare         Decimal          @default(1) @db.Decimal(24, 10)
  certificated          Boolean          @default(true)
  parValue              Decimal?         @db.Decimal(24, 10)
  /// Lower is paid first; equal seniority with pariPassu shares a rank.
  seniority             Int              @default(1)
  pariPassu             Boolean          @default(true)
  originalIssuePrice    Decimal?         @db.Decimal(24, 10)
  conversionPrice       Decimal?         @db.Decimal(24, 10)
  conversionRatio       Decimal          @default(1) @db.Decimal(24, 10)
  /// Liquidation preference multiple.
  multiplier            Decimal          @default(1) @db.Decimal(24, 10)
  participating         Boolean          @default(false)
  /// Participation cap as a multiple of the original issue price; null is uncapped.
  participationCap      Decimal?         @db.Decimal(24, 10)
  dividend              Boolean          @default(false)
  /// Percent per year.
  dividendYield         Decimal?         @db.Decimal(24, 10)
  cumulative            Boolean          @default(false)
  /// daily | monthly | quarterly | semi_annually | annually
  dividendAccrual       String?
  compoundingInterest   Boolean          @default(false)
  /// actual_365 | actual_360 | 30_360
  dayCountConvention    String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([shareClassId, documentDate])
  @@map("equity_share_class_versions")
}

/// An equity incentive plan and its reserved pool.
model EquityPlan {
  id             String           @id @default(cuid())
  spaceId        String
  userId         String
  ledger         EquityLedger     @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  name           String
  /// active | inactive
  status         String           @default("active")
  /// The class the plan's awards are in (usually common).
  shareClassId   String
  shareClass     EquityShareClass @relation(fields: [shareClassId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  reservedShares BigInt
  boardApprovedOn DateTime?       @db.Date
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  certificates   EquityCertificate[]
  optionGrants   EquityOptionGrant[] @relation("EquityOptionGrantPlan")
  transactions   EquityTransaction[]

  @@unique([id, spaceId, userId])
  @@unique([id, shareClassId, spaceId, userId])
  @@unique([spaceId, userId, name])
  @@map("equity_plans")
}

/// A reusable vesting rule, e.g. "1/48 monthly, 1 year cliff".
model EquityVestingTemplate {
  id              String       @id @default(cuid())
  spaceId         String
  userId          String
  ledger          EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  name            String
  totalMonths     Int
  cliffMonths     Int          @default(0)
  /// Months between vesting events after the cliff (1 is monthly).
  frequencyMonths Int          @default(1)
  /// Custom tranches instead of the even rule: [{ monthOffset, percent }], percents summing to 100.
  tranches        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  schedules       EquityVestingSchedule[]

  @@unique([id, spaceId, userId])
  @@unique([spaceId, userId, name])
  @@map("equity_vesting_templates")
}

/// The vesting of one security: a template (or its own tranches) from a start date.
model EquityVestingSchedule {
  id                String                 @id @default(cuid())
  spaceId           String
  userId            String
  ledger            EquityLedger           @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  templateId        String?
  template          EquityVestingTemplate? @relation(fields: [templateId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  startDate         DateTime               @db.Date
  totalMonths       Int
  cliffMonths       Int                    @default(0)
  frequencyMonths   Int                    @default(1)
  /// [{ monthOffset, percent }] or null for the even rule.
  tranches          Json?
  /// Shares vested at once on acceleration, and when.
  acceleratedShares BigInt?
  acceleratedOn     DateTime?              @db.Date
  /// Vesting stops on this date (termination).
  stoppedOn         DateTime?              @db.Date
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  certificate       EquityCertificate?
  optionGrant       EquityOptionGrant?

  @@unique([id, spaceId, userId])
  @@map("equity_vesting_schedules")
}

/// An issued share certificate. Never deleted: canceled, transferred, repurchased or converted.
model EquityCertificate {
  id                       String                 @id @default(cuid())
  spaceId                  String
  userId                   String
  ledger                   EquityLedger           @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// Security ID shown in the ledger, e.g. CS-12.
  label                    String
  stakeholderId            String
  stakeholder              EquityStakeholder      @relation(fields: [stakeholderId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  shareClassId             String
  shareClass               EquityShareClass       @relation(fields: [shareClassId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  planId                   String?
  plan                     EquityPlan?            @relation(fields: [planId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  /// See EQUITY_CERTIFICATE_STATUSES.
  status                   String                 @default("outstanding")
  /// See EQUITY_ACCEPTANCE_STATUSES.
  acceptanceStatus         String                 @default("accepted")
  /// paper | electronic
  paperStatus              String                 @default("electronic")
  quantity                 BigInt
  /// Company-provided price per share.
  pricePerShare            Decimal?               @db.Decimal(24, 10)
  pricePaidPerShare        Decimal?               @db.Decimal(24, 10)
  cashPaidCents            BigInt                 @default(0)
  debtCanceledCents        BigInt                 @default(0)
  ipTransferredCents       BigInt                 @default(0)
  otherConsiderationCents  BigInt                 @default(0)
  costBasisCents           BigInt?
  issueDate                DateTime               @db.Date
  originalAcquisitionDate  DateTime?              @db.Date
  issuedBy                 String?
  boardApprovedOn          DateTime?              @db.Date
  rule144Date              DateTime?              @db.Date
  federalExemption         String?
  stateExemption           String?
  stateOfResidency         String?
  legend                   String?
  /// The holder's details as of the issue date: { name, email, dateOfBirth, relationship, taxId, employeeId, payrollId }.
  personnel                Json?
  collateralized           Boolean                @default(false)
  vestingScheduleId        String?                @unique
  vestingSchedule          EquityVestingSchedule? @relation(fields: [vestingScheduleId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  /// The certificate this one came from (transfer remainder, conversion, exercise lineage).
  parentId                 String?
  parent                   EquityCertificate?     @relation("EquityCertificateLineage", fields: [parentId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  children                 EquityCertificate[]    @relation("EquityCertificateLineage")
  roundId                  String?
  round                    EquityFundingRound?    @relation(fields: [roundId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  canceledOn               DateTime?              @db.Date
  adminNotes               String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  convertedFrom            EquityConvertible[]    @relation("EquityConvertibleConvertedTo")
  exercises                EquityExercise[]
  transactions             EquityTransaction[]
  documentLinks            EquityDocumentLink[]

  /// Client idempotency key and a hash of the request, so a retry replays the first create.
  requestKey String? @db.Uuid
  requestHash String?
  @@unique([id, spaceId, userId])
  @@unique([vestingScheduleId, spaceId, userId])
  @@unique([spaceId, userId, label])
  @@index([spaceId, userId, status])
  @@index([stakeholderId])
  @@index([shareClassId])
  @@unique([spaceId, userId, requestKey])
  @@map("equity_certificates")
}

/// Convertibles sharing terms, e.g. one block per SAFE round.
model EquityConvertibleBlock {
  id                 String       @id @default(cuid())
  spaceId            String
  userId             String
  ledger             EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  name               String
  /// safe | note
  kind               String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  convertibles       EquityConvertible[]

  /// Client idempotency key and a hash of the request, so a retry replays the first create.
  requestKey String? @db.Uuid
  requestHash String?
  @@unique([id, spaceId, userId])
  @@unique([spaceId, userId, name])
  @@unique([spaceId, userId, requestKey])
  @@map("equity_convertible_blocks")
}

/// A SAFE or a convertible note.
model EquityConvertible {
  id                     String                  @id @default(cuid())
  spaceId                String
  userId                 String
  ledger                 EquityLedger            @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// Security ID shown in the ledger, e.g. SAFE-3.
  label                  String
  stakeholderId          String
  stakeholder            EquityStakeholder       @relation(fields: [stakeholderId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  blockId                String?
  block                  EquityConvertibleBlock? @relation(fields: [blockId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  /// safe | note
  kind                   String
  /// See EQUITY_CONVERTIBLE_STATUSES.
  status                 String                  @default("outstanding")
  principalCents         BigInt
  issueDate              DateTime                @db.Date
  issuedBy               String?
  boardApprovedOn        DateTime?               @db.Date
  /// Notes: percent per year, simple or compound interest from interestStartDate.
  interestRate           Decimal?                @db.Decimal(24, 10)
  interestStartDate      DateTime?               @db.Date
  /// simple | compound
  interestType           String?
  /// actual_365 | actual_360 | 30_360
  dayCountConvention     String?
  maturityDate           DateTime?               @db.Date
  valuationCapCents      BigInt?
  /// pre_money | post_money
  valuationCapType       String?
  /// Percent off the round price.
  discountPercent        Decimal?                @db.Decimal(24, 10)
  conversionPriceBasis   String?
  liquidityPriority      String?
  convertsToShareClassId String?
  convertsToShareClass   EquityShareClass?       @relation(fields: [convertsToShareClassId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  cashoutMultiplier      Decimal?                @db.Decimal(24, 10)
  mfn                    Boolean                 @default(false)
  proRata                Boolean                 @default(false)
  federalExemption       String?
  stateExemption         String?
  stateOfResidency       String?
  canceledOn             DateTime?               @db.Date
  closedOn               DateTime?               @db.Date
  cancellationReason     String?
  convertedToId          String?
  convertedTo            EquityCertificate?      @relation("EquityConvertibleConvertedTo", fields: [convertedToId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  roundId                String?
  round                  EquityFundingRound?     @relation(fields: [roundId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  /// securities area: the Fundraising `Safe` this convertible records, so the read-through list hides it.
  sourceSafeId           String?
  adminNotes             String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  transactions           EquityTransaction[]

  /// Client idempotency key and a hash of the request, so a retry replays the first create.
  requestKey String? @db.Uuid
  requestHash String?
  @@unique([id, spaceId, userId])
  @@unique([spaceId, userId, label])
  @@index([spaceId, userId, status])
  @@unique([spaceId, userId, sourceSafeId])
  @@index([stakeholderId])
  @@unique([spaceId, userId, requestKey])
  @@map("equity_convertibles")
}

/// An option grant under a plan.
model EquityOptionGrant {
  id                         String                 @id @default(cuid())
  spaceId                    String
  userId                     String
  ledger                     EquityLedger           @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// Security ID shown in the ledger, e.g. ES-40.
  label                      String
  stakeholderId              String
  stakeholder                EquityStakeholder      @relation(fields: [stakeholderId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  planId                     String
  plan                       EquityPlan             @relation("EquityOptionGrantPlan", fields: [planId, shareClassId, spaceId, userId], references: [id, shareClassId, spaceId, userId], onDelete: NoAction)
  shareClassId               String
  shareClass                 EquityShareClass       @relation("EquityOptionGrantShareClass", fields: [shareClassId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  /// See EQUITY_OPTION_STATUSES.
  status                     String                 @default("outstanding")
  /// iso | nso
  optionType                 String
  /// Original quantity granted.
  quantity                   BigInt
  exercisedQuantity          BigInt                 @default(0)
  canceledQuantity           BigInt                 @default(0)
  exercisePrice              Decimal                @db.Decimal(24, 10)
  grantDate                  DateTime               @db.Date
  expirationDate             DateTime?              @db.Date
  boardApprovedOn            DateTime?              @db.Date
  /// Months after termination the holder may still exercise.
  postTerminationExerciseMonths Int?
  earlyExercise              Boolean                @default(false)
  acceptanceStatus           String                 @default("accepted")
  vestingScheduleId          String?                @unique
  vestingSchedule            EquityVestingSchedule? @relation(fields: [vestingScheduleId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  canceledOn                 DateTime?              @db.Date
  adminNotes                 String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  exercises                  EquityExercise[]
  transactions               EquityTransaction[]

  /// Client idempotency key and a hash of the request, so a retry replays the first create.
  requestKey String? @db.Uuid
  requestHash String?
  @@unique([id, spaceId, userId])
  @@unique([vestingScheduleId, spaceId, userId])
  @@unique([spaceId, userId, label])
  @@index([spaceId, userId, status])
  @@index([stakeholderId])
  @@index([planId])
  @@unique([spaceId, userId, requestKey])
  @@map("equity_option_grants")
}

/// An exercise of options, pending until it settles into a certificate.
model EquityExercise {
  id            String             @id @default(cuid())
  spaceId       String
  userId        String
  ledger        EquityLedger       @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  optionGrantId String
  optionGrant   EquityOptionGrant  @relation(fields: [optionGrantId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  quantity      BigInt
  exerciseDate  DateTime           @db.Date
  /// pending | completed | canceled
  status        String             @default("pending")
  paymentCents  BigInt             @default(0)
  requestKey    String?            @db.Uuid
  certificateId String?
  certificate   EquityCertificate? @relation(fields: [certificateId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([spaceId, userId, exerciseDate, id])
  @@index([optionGrantId])
  @@unique([spaceId, userId, requestKey])
  @@map("equity_exercises")
}

/// One change to a holding, append-only (row security allows only SELECT and INSERT for the app).
model EquityTransaction {
  id             String             @id @default(cuid())
  spaceId        String
  userId         String
  ledger         EquityLedger       @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// See EQUITY_TRANSACTION_KINDS.
  kind           String
  effectiveDate  DateTime           @db.Date
  /// The reason picked on the form (transfer, repurchase, cancellation or modification reason).
  reason         String?
  certificateId  String?
  certificate    EquityCertificate? @relation(fields: [certificateId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  convertibleId  String?
  convertible    EquityConvertible? @relation(fields: [convertibleId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  optionGrantId  String?
  optionGrant    EquityOptionGrant? @relation(fields: [optionGrantId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  /// Only the stakeholder merge writes this, so a warrant that moves holders has an audit row.
  warrantId      String?
  warrant        EquityWarrant?     @relation(fields: [warrantId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  planId         String?
  plan           EquityPlan?        @relation(fields: [planId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  quantity       BigInt?
  valueCents     BigInt?
  /// The record before and after, as the contract shapes them; null before an issue.
  before         Json?
  after          Json?
  /// Ids of rows this transaction created (new certificates of a transfer or conversion).
  resulting      Json               @default("[]")
  note           String?
  /// Who made the change: the signed-in user's display name at the time.
  actorName      String?
  createdAt      DateTime           @default(now())

  /// Client idempotency key and a hash of the request, so a retry replays the first create.
  requestKey String? @db.Uuid
  requestHash String?
  @@index([spaceId, userId, createdAt])
  @@index([certificateId])
  @@index([convertibleId])
  @@index([optionGrantId])
  @@index([warrantId])
  @@unique([spaceId, userId, requestKey])
  @@map("equity_transactions")
}

/// A named set of draft securities, issued together.
model EquityDraftSet {
  id           String       @id @default(cuid())
  spaceId      String
  userId       String
  ledger       EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  name         String
  /// certificate | option_grant | convertible
  securityKind String
  /// draft | issued | discarded
  status       String       @default("draft")
  revision     Int          @default(1)
  issuedIds    String[]     @default([])
  /// The draft securities, each the create input of its kind.
  items        Json         @default("[]")
  issuedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([spaceId, userId, status])
  @@map("equity_draft_sets")
}

/// A funding round. Securities join it by roundId; without members it groups by issue date.
model EquityFundingRound {
  id                     String       @id @default(cuid())
  spaceId                String
  userId                 String
  ledger                 EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  name                   String
  startDate              DateTime     @db.Date
  endDate                DateTime?    @db.Date
  closingDate            DateTime?    @db.Date
  originalIssuePrice     Decimal?     @db.Decimal(24, 10)
  preMoneyValuationCents BigInt?
  pricingSnapshot        Json?
  /// Values typed over the computed ones: { cashRaisedCents?, sharesIssued?, fullyDilutedShares?, postMoneyValuationCents? }.
  overrides              Json         @default("{}")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  certificates           EquityCertificate[]
  convertibles           EquityConvertible[]
  documentLinks          EquityDocumentLink[]

  @@unique([id, spaceId, userId])
  @@unique([spaceId, userId, name])
  @@map("equity_funding_rounds")
}

/// A saved filtered view of one cap table list.
model EquitySavedView {
  id        String       @id @default(cuid())
  spaceId   String
  userId    String
  ledger    EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// The tab it belongs to, e.g. stakeholders, securities.
  page      String
  name      String
  /// The list's query string (filters, sort, columns).
  params    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([spaceId, userId, page, name])
  @@map("equity_saved_views")
}

/// The cap table access level for one stakeholder group.
model EquityAccessGroup {
  id        String       @id @default(cuid())
  spaceId   String
  userId    String
  ledger    EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// founders | investors | employees | former_employees | other
  key       String
  /// full_detail | advanced | basic | restricted | none
  level     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([spaceId, userId, key])
  @@map("equity_access_groups")
}

/// One stakeholder's access: an override of the group level and an open request for more.
model EquityAccessGrant {
  id             String            @id @default(cuid())
  spaceId        String
  userId         String
  ledger         EquityLedger      @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  stakeholderId  String
  stakeholder    EquityStakeholder @relation(fields: [stakeholderId, spaceId, userId], references: [id, spaceId, userId], onDelete: Cascade)
  /// Null uses the group level.
  level          String?
  requestedLevel String?
  requestedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([stakeholderId, spaceId, userId])
  @@index([spaceId, userId])
  @@map("equity_access_grants")
}

/// One data health check result: open until resolved, or dismissed.
model EquityHealthFinding {
  id          String       @id @default(cuid())
  spaceId     String
  userId      String
  ledger      EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// The check's key, e.g. duplicated_stakeholder.
  check       String
  /// share_classes | company | securities | documents | stakeholder
  tag         String
  /// required | recommended
  severity    String
  /// open | dismissed | resolved
  status      String       @default("open")
  /// Identifies the offending rows so a rerun updates the same finding.
  fingerprint String
  /// The offending rows, as the check shapes them.
  rows        Json         @default("[]")
  detectedAt  DateTime     @default(now())
  dismissedAt DateTime?
  updatedAt   DateTime     @updatedAt

  @@unique([spaceId, userId, check, fingerprint])
  @@index([spaceId, userId, status])
  @@map("equity_health_findings")
}

// ==== End cap table foundation section ======================================================
// ---- cap table: stakeholders area ----
/// A proposed change to the stakeholder list, waiting for review: an external employee to match
/// (kind match), a termination (termination) or new profile values (profile). Imported from a
/// file today; the holder's portfolio may also propose profile values (source portfolio).
model EquityStakeholderChange {
  id              String       @id @default(cuid())
  spaceId         String
  userId          String
  ledger          EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// match | termination | profile
  kind            String
  /// file | portfolio
  source          String
  /// The stakeholder it applies to; null for an external employee not matched yet.
  stakeholderId   String?
  stakeholder     EquityStakeholder? @relation(fields: [stakeholderId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  employeeId      String?
  externalName    String?
  externalEmail   String?
  /// The proposed values: { firstName, lastName, contactEmail, dateOfBirth, taxId, jobTitle,
  /// costCenter, department, address } (only the fields the source gave).
  proposed        Json         @default("{}")
  terminationDate DateTime?    @db.Date
  /// pending | accepted | rejected
  status          String       @default("pending")
  acceptedFields  String[]     @default([])
  resolvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([spaceId, userId, status, kind])
  @@map("equity_stakeholder_changes")
}

/// How file and HRIS data may update stakeholders without review. One row per ledger.
model EquityHrisPreferences {
  id          String       @id @default(cuid())
  spaceId     String
  userId      String
  ledger      EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  autoUpdates Boolean      @default(false)
  /// address | cost_center | department | hire_date | job_title | tax_id
  autoFields  String[]     @default([])
  autoCreate  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([spaceId, userId])
  @@map("equity_hris_preferences")
}
// ---- cap table: securities area ----
// ---- cap table: options area ----
/// A warrant: the right to buy shares of a class at a price. Never deleted; canceled instead.
model EquityWarrant {
  id             String            @id @default(cuid())
  spaceId        String
  userId         String
  ledger         EquityLedger      @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// Security ID, e.g. W-3.
  label          String
  stakeholderId  String
  stakeholder    EquityStakeholder @relation(fields: [stakeholderId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  shareClassId   String
  shareClass     EquityShareClass  @relation(fields: [shareClassId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  quantity       BigInt
  exercisePrice  Decimal           @db.Decimal(24, 10)
  issueDate      DateTime          @db.Date
  expirationDate DateTime?         @db.Date
  /// outstanding | canceled
  status         String            @default("outstanding")
  canceledOn     DateTime?         @db.Date
  adminNotes     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  transactions   EquityTransaction[]

  /// Client idempotency key and a hash of the request, so a retry replays the first create.
  requestKey String? @db.Uuid
  requestHash String?
  @@unique([id, spaceId, userId])
  @@unique([spaceId, userId, label])
  @@index([spaceId, userId, status])
  @@unique([spaceId, userId, requestKey])
  @@map("equity_warrants")
}
// ---- cap table: views area ----

/// A saved round modeling scenario. Never changes the ledger.
model EquityRoundScenario {
  id                     String   @id @default(cuid())
  spaceId                String
  userId                 String
  name                   String
  preMoneyValuationCents BigInt
  /// Unallocated pool as a percent of post-money fully diluted; null keeps the pool.
  targetPoolPercent      Decimal? @db.Decimal(24, 10)
  /// [{ name, amountCents }]
  investments            Json     @default("[]")
  /// Convertible ids to convert; null converts every outstanding one.
  convertibleIds         Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  ledger                 EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)

  @@unique([spaceId, userId, name])
  @@map("equity_round_scenarios")
}

/// A report someone generated: its kind, options and as-of date, so it can be reopened.
model EquityReportRun {
  id        String       @id @default(cuid())
  spaceId   String
  userId    String
  /// See EQUITY_REPORT_KINDS.
  kind      String
  asOf      DateTime     @db.Date
  /// { groupBy, fullyDiluted, includeConvertibles }
  options   Json         @default("{}")
  createdAt DateTime     @default(now())
  ledger    EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)

  @@index([spaceId, userId, createdAt])
  @@map("equity_report_runs")
}

/// Views settings for one ledger: the estimated value of holdings.
model EquityViewsSettings {
  spaceId                  String
  userId                   String
  /// hidden | holders
  estimatedValueVisibility String    @default("hidden")
  pricePerShare            Decimal?  @db.Decimal(24, 10)
  effectiveDate            DateTime? @db.Date
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  ledger                   EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)

  @@id([spaceId, userId])
  @@map("equity_views_settings")
}
/// Append-only history of cap table changes that are not securities transactions: access levels,
/// contact and document links, the estimated value settings and stakeholder edits. A trigger blocks
/// UPDATE and DELETE (migration 20261231000161), except when the whole ledger is deleted.
model EquityAuditEvent {
  id            String       @id @default(cuid())
  spaceId       String
  userId        String
  ledger        EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// access.group_level | access.grant_level | access.request | access.resolve | contact.link |
  /// contact.unlink | document.link | document.unlink | estimated_value.set | stakeholder.update
  kind          String
  /// group | stakeholder | document_link | views_settings
  subjectType   String
  subjectId     String
  /// The signed-in user who made the change. Not a foreign key: the row outlives the user record.
  actorUserId   String
  before        Json?
  after         Json?
  at            DateTime     @default(now())

  @@index([spaceId, userId, at])
  @@index([spaceId, userId, subjectType, subjectId])
  @@map("equity_audit_events")
}

// ---- cap table: access area ----

/// A Data room document attached to one stakeholder, certificate or funding round of the ledger.
/// Exactly one target is set. The ids are checked against the ledger by the store.
model EquityDocumentLink {
  id             String       @id @default(cuid())
  spaceId        String
  userId         String
  ledger         EquityLedger @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  dataRoomItemId String
  dataRoomItem   DataRoomItem @relation("EquityDocumentItem", fields: [dataRoomItemId, spaceId, userId], references: [id, spaceId, userId], onDelete: Cascade)
  stakeholderId  String?
  stakeholder    EquityStakeholder? @relation(fields: [stakeholderId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  certificateId  String?
  certificate    EquityCertificate? @relation(fields: [certificateId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  roundId        String?
  round          EquityFundingRound? @relation(fields: [roundId, spaceId, userId], references: [id, spaceId, userId], onDelete: NoAction)
  createdAt      DateTime     @default(now())

  @@index([spaceId, userId, dataRoomItemId])
  @@map("equity_document_links")
}

/// A Data room document delivery that was already made, so a retry with the same key sends nothing.
model InvestorShareRequest {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestKey  String   @db.Uuid
  requestHash String
  createdAt   DateTime @default(now())
  /// Null while the first delivery is in flight.
  completedAt DateTime?

  @@unique([spaceId, userId, requestKey])
  @@map("investor_share_requests")
}
