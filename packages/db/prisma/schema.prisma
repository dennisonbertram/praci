/// Mail metadata cached for the Inbox list, the unread count and mail searches. Bodies are never stored.
model CachedMailMessage {
  id                String      @id @default(cuid())
  spaceId           String
  space             Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId      String
  connection        Connection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  providerMessageId String
  threadId          String
  fromName          String?
  fromAddress       String
  toAddresses       String[]
  ccAddresses       String[]
  subject           String
  snippet           String
  receivedAt        DateTime
  unread            Boolean
  /// Set by sync from the in:inbox list.
  inInbox           Boolean     @default(false)
  /// Set by sync from the in:sent list.
  fromSelf          Boolean     @default(false)
  /// Null until triage has looked at the message.
  needsReply        Boolean?
  /// Set when triage has classified (or skipped past) the message.
  triagedAt         DateTime?
  /// TRIAGE_VERSION that classified the row; a bump re-triages it.
  triageVersion     Int?
  /// "critical" | "important" | "normal" | "low".
  priority          String?
  /// "reply" | "action" | "fyi" | "bulk" | "suspicious".
  category          String?
  /// One short line shown under the to-do.
  reason            String?
  /// Candidate to-do text; null when there is nothing to do.
  todoText          String?
  dueOn             DateTime?   @db.Date
  /// Computed in code: the user sent a later message in the same thread.
  alreadyHandled    Boolean     @default(false)
  /// Last time a sync or a search wrote this row.
  seenAt            DateTime
  /// Sync archived this message because its sender skips the inbox. Set once and never cleared, so an undo is not archived again.
  skipAppliedAt     DateTime?
  /// The user chose Not spam: the model's spam verdict no longer puts this message back in the Spam pile. Cleared when the user marks it spam.
  notSpamAt         DateTime?
  /// MailSignals (List-Unsubscribe, auth results, Gmail category flags); null until fetched.
  signals           Json?
  /// MAIL_SIGNALS_VERSION that produced `signals`; an older value makes sync fetch the row again.
  signalsVersion    Int         @default(0)
  /// Gmail put the message in spam. Such a row is never in the inbox.
  isSpam            Boolean     @default(false)
  /// The pile the free rules chose; null means they left it to the model.
  rulePile          String?
  /// Short codes for why the rules decided or passed.
  ruleReasons       String[]    @default([])
  /// "important" | "updates" | "newsletters" | "spam": rulePile, else the model's category mapped to a pile.
  pile              String?
  inboxTodos        InboxTodo[]

  @@unique([connectionId, providerMessageId])
  @@index([spaceId, userId, inInbox, receivedAt])
  @@map("mail_messages")
}

/// One sender as seen by one mail account, over the synced window.
model MailSenderStat {
  id                    String     @id @default(cuid())
  spaceId               String
  space                 Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId                String
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId          String
  connection            Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Lowercased From address.
  senderAddress         String
  /// Window messages from the sender: not sent by the user, not spam.
  messageCount          Int        @default(0)
  readCount             Int        @default(0)
  lastReceivedAt        DateTime?
  /// First entry of the newest message's listUnsubscribe, and whether that message was one-click.
  unsubscribeTarget     String?
  oneClick              Boolean    @default(false)
  /// The newest message had List-Unsubscribe, List-Id or bulk precedence.
  bulk                  Boolean    @default(false)
  /// true: the user sent mail to this address. false: searched, none found. null: not checked.
  priorContact          Boolean?
  priorContactCheckedAt DateTime?
  /// Pile the model chose for this sender often enough to reuse: "important" | "updates" | "newsletters". Null: none.
  learnedPile           String?
  /// Agreeing model verdicts when it was learned.
  learnedCount          Int        @default(0)
  learnedAt             DateTime?
  /// The user forgot the learned pile; only mail received after this counts toward learning again.
  learnedForgottenAt    DateTime?

  @@unique([connectionId, senderAddress])
  @@map("mail_sender_stats")
}

/// The user's decision about one sender on one mail account. Deleting the row forgets it.
model MailSenderDecision {
  id                String     @id @default(cuid())
  spaceId           String
  space             Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId      String
  connection        Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Lowercased From address.
  senderAddress     String
  /// Set while future mail from the sender is archived during sync; mail received before it is left alone.
  skipInboxAt       DateTime?
  /// Last unsubscribe attempt: "done" | "opened" | "sent" | "unknown" | "failed" | "refused". Null: none.
  unsubscribeStatus String?
  /// "one_click" | "link" | "mailto".
  unsubscribeMethod String?
  unsubscribedAt    DateTime?
  /// Gmail filter this decision created, so Stop and Undo can delete it. Null: none, or Gmail already had an identical one.
  ruleId            String?
  /// "active" | "pending" (waiting for permission) | "full" (the 1,000-filter cap) | "failed". Null: Praci-side only.
  ruleStatus        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([connectionId, senderAddress])
  @@index([spaceId, userId])
  @@map("mail_sender_decisions")
}

/// One bulk action on one mail account, kept so it can be listed and undone. A click that spans
/// accounts writes one row per account, sharing batchId.
model MailActionLog {
  id              String     @id @default(cuid())
  spaceId         String
  space           Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  batchId         String
  /// "archive" | "skip_inbox" | "unsubscribe" | "spam" | "not_spam" | "trash".
  kind            String
  /// "user" | "auto".
  source          String
  /// "cleanup" | "selection" | "skip_inbox".
  reason          String
  senderAddresses String[]   @default([])
  /// Provider thread ids that changed. Undo works from these, so it still works after sync prunes the cache rows.
  threadIds       String[]   @default([])
  createdAt       DateTime   @default(now())
  undoneAt        DateTime?

  @@unique([connectionId, batchId])
  @@index([spaceId, userId, createdAt])
  @@map("mail_action_logs")
}

/// A private to-do created by triage from one cached message. Scoped to one user in one space,
/// never shown on the shared ticket board. Triage replaces only untouched, unfinished rows.
model InboxTodo {
  id           String             @id @default(cuid())
  spaceId      String
  space        Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null for a meeting to-do, which does not depend on a mail connection. Mail to-dos go with their connection.
  connectionId String?
  connection   Connection?        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Set for a to-do that came from a meeting. S6's explicit meeting delete removes these.
  meetingId    String?
  meeting      Meeting?           @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  /// Set null when the cache prunes the message.
  messageId    String?
  message      CachedMailMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  text         String
  /// Copied from the message's reason.
  detail       String?
  dueOn        DateTime?          @db.Date
  doneAt       DateTime?
  /// Set on any user action; touched to-dos are never replaced.
  touchedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  /// One to-do per message; Postgres allows many NULLs.
  @@unique([userId, messageId])
  @@index([spaceId, userId, doneAt])
  @@index([meetingId])
  @@map("inbox_todos")
}

/// A user's "important" or "noise" mark on one sender address. Per user and space, not per
/// connection: it covers all the user's mail accounts and outlives disconnecting one.
model InboxSenderFeedback {
  id            String   @id @default(cuid())
  spaceId       String
  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lowercased.
  senderAddress String
  /// "important" | "noise".
  mark          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([spaceId, userId, senderAddress])
  @@map("inbox_sender_feedback")
}

/// One compose session's draft and send record, keyed by a client-generated id so a retried or
/// double-clicked send never sends twice. Holds ids and state only, never recipients or text.
model ComposeSend {
  id                String     @id @default(cuid())
  spaceId           String
  space             Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId      String
  connection        Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Chosen by the browser when the composer opens.
  clientId          String
  /// The Gmail draft, once one is saved.
  draftId           String?
  /// "draft" | "pending" | "sent" | "failed" | "unknown" | "abandoned". A send that may have
  /// happened is "unknown" and is never retried. "abandoned": recovery settled a claim that never
  /// reached the provider; it can no longer be claimed, so nothing is ever sent.
  state             String     @default("draft")
  providerMessageId String?
  threadId          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([spaceId, userId, clientId])
  @@index([connectionId])
  @@map("compose_sends")
}

/// Sync throttle and in-flight claim for one mail connection.
model MailSyncState {
  connectionId    String     @id
  connection      Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Last successful sync.
  lastSyncedAt    DateTime?
  /// Claim held by the process that is syncing; stale after 2 minutes.
  syncStartedAt   DateTime?
  /// Set when the last sync failed outright (provider error, nothing stored). An incomplete sync,
  /// where some messages could not be hydrated, is not a failure. Cleared by any sync that stored mail.
  lastErrorAt     DateTime?
  /// The last failure was the provider refusing the login, so the account needs reconnecting.
  needsReconnect  Boolean    @default(false)
  /// MailProviderError.kind of the last failure ("rate_limited", "auth", ...); "unknown" for a
  /// non-provider error. Cleared with lastErrorAt.
  lastErrorKind   String?
  /// A rate-limited sync sets this; no sync for the connection starts before it. Cleared by a complete sync.
  backoffUntil    DateTime?
  /// Random id of the sync holding the claim; every write checks it.
  claimToken      String?
  /// Provider change cursor (Gmail historyId) as of the last complete sync. Null until the first
  /// one; a sync that finds it expired lists the cache window again and replaces it.
  changeCursor    String?
  /// Set when a sync job is queued, cleared when that job finishes. Shows "syncing" before the claim
  /// exists; ignored after 2 minutes.
  syncRequestedAt DateTime?
  /// Older mail still to cache after the first sync: { inbox: "YYYY-MM-DD" | null, sent: ... }. Null: window complete.
  backfill        Json?
  /// Lowercased mailbox address of the active Gmail watch; null: no watch.
  watchAddress    String?
  watchExpiresAt  DateTime?
  /// historyId the watch started at. Informational: sync keeps its own cursor in changeCursor.
  watchHistoryId  String?

  @@index([watchAddress])
  @@map("mail_sync_states")
}

// Finance (Mercury and Brex). Each row belongs to the McpServer it was synced from, so removing the
// server deletes its finance data. spaceId and userId repeat the server's; every query filters on both.
// Money is whole cents in BigInt (a wire or a Treasury balance can pass the Int range); code converts
// to number at the repository edge.

/// A bank or card account as of the last sync.
model FinanceAccount {
  id           String     @id @default(cuid())
  spaceId      String
  userId       String
  /// Null for an account fed by uploaded statements (provider "statement").
  mcpServerId  String?
  server       McpServer? @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  /// "mercury" | "brex" | "statement"
  provider     String
  externalId   String
  name         String
  lastFour     String?
  /// "checking" | "savings" | "treasury" | "card"
  kind         String
  /// For a card: the balance owed, positive.
  balanceCents BigInt
  currency     String
  updatedAt    DateTime   @updatedAt

  statements FinanceStatement[]

  // finance_accounts_statement_key is raw SQL (partial unique on spaceId, userId, externalId where provider = 'statement').
  @@unique([mcpServerId, externalId])
  @@index([spaceId, userId])
  @@map("finance_accounts")
}

/// A bank statement the user uploaded. The original file is kept in Postgres (10 MB cap enforced by the API).
model FinanceStatement {
  id                  String          @id @default(cuid())
  spaceId             String
  userId              String
  accountId           String?
  account             FinanceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fileName            String
  /// "csv" | "ofx" | "pdf"
  format              String
  fileSha256          String
  fileSize            Int
  fileBytes           Bytes
  /// The ParsedStatement, as the parser returned it.
  parsed              Json?
  /// "review" | "imported" | "failed"
  status              String
  check               Json?
  warnings            Json
  error               String?
  institution         String?
  accountLast4        String?
  periodStart         String?
  periodEnd           String?
  openingBalanceCents BigInt?
  closingBalanceCents BigInt?
  transactionCount    Int             @default(0)
  createsAccount      Boolean         @default(false)
  duplicateCount      Int             @default(0)
  uploadedAt          DateTime        @default(now())

  @@index([spaceId, userId, uploadedAt])
  @@index([accountId, status])
  @@map("finance_statements")
}

/// One provider transaction or Brex expense, normalized.
model FinanceTransaction {
  id                String     @id @default(cuid())
  spaceId           String
  userId            String
  /// Null for a transaction imported from a statement (provider "statement").
  mcpServerId       String?
  server            McpServer? @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  provider          String
  externalId        String
  accountExternalId String
  postedAt          DateTime
  /// Brex purchase date; spend is counted by it.
  purchasedAt       DateTime?
  /// Signed; negative is money out.
  amountCents       BigInt
  currency          String
  counterparty      String
  /// Normalized counterparty; the vendor, recurring and subscription grouping key.
  vendorKey         String
  category          String?
  /// "pending" | "posted" | "other"
  status            String
  /// The provider's own kind or expense type.
  kind              String
  /// "spend" | "revenue" | "financing" | "internal_transfer" | "card_payment". Depends on whether
  /// Brex is connected, so every sync recomputes it for all of the user's rows.
  classification    String
  cardLastFour      String?
  cardholder        String?
  memo              String?
  hasReceipt        Boolean    @default(false)
  dashboardUrl      String?
  updatedAt         DateTime   @updatedAt
  safe              Safe?

  // finance_transactions_statement_key is raw SQL (partial unique where provider = 'statement').
  @@unique([mcpServerId, externalId])
  @@index([spaceId, userId, postedAt])
  @@index([spaceId, userId, vendorKey])
  @@map("finance_transactions")
}

/// Mercury Treasury net return for one account and month.
model FinanceTreasuryYield {
  id                String    @id @default(cuid())
  spaceId           String
  userId            String
  mcpServerId       String
  server            McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  accountExternalId String
  /// YYYY-MM
  month             String
  dividendsCents    BigInt
  feeCents          BigInt
  netCents          BigInt
  updatedAt         DateTime  @updatedAt

  @@unique([mcpServerId, accountExternalId, month])
  @@index([spaceId, userId, month])
  @@map("finance_treasury_yields")
}

/// A Brex bill not yet paid. The set is replaced on every sync; used for Upcoming.
model FinanceBill {
  id          String    @id @default(cuid())
  spaceId     String
  userId      String
  mcpServerId String
  server      McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  provider    String
  externalId  String
  vendorName  String
  vendorKey   String
  dueAt       DateTime
  amountCents BigInt
  status      String
  updatedAt   DateTime  @updatedAt

  @@unique([mcpServerId, externalId])
  @@index([spaceId, userId, dueAt])
  @@map("finance_bills")
}

/// Sync throttle and in-flight claim for one finance MCP server (the MailSyncState pattern).
model FinanceSyncState {
  mcpServerId    String    @id
  server         McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  spaceId        String
  userId         String
  /// Last successful sync; null means the 13-month backfill has not completed.
  lastSyncedAt   DateTime?
  /// Claim held by the process that is syncing; stale after 2 minutes.
  syncStartedAt  DateTime?
  /// Random id of the sync holding the claim; every write checks it.
  claimToken     String?
  /// Set when the last sync failed; cleared by the next success.
  lastErrorAt    DateTime?
  /// Short failure reason for the page; never a vendor payload or credential.
  lastError      String?
  /// The vendor refused the login, so the user must reconnect.
  needsReconnect Boolean   @default(false)

  @@map("finance_sync_states")
}

/// An EVM wallet the user tracks on the Crypto page. Not tied to an McpServer; read-only, never signs.
model FinanceWallet {
  id            String                  @id @default(cuid())
  spaceId       String
  userId        String
  /// Lowercase 0x address.
  address       String
  ensName       String?
  label         String?
  /// "personal" | "safe" | "exchange" | "contract"
  type          String
  /// Safe only: lowercase owner addresses.
  safeOwners    Json?
  safeThreshold Int?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  holdings      FinanceCryptoHolding[]
  snapshots     FinanceCryptoSnapshot[]

  @@unique([spaceId, userId, address])
  @@index([spaceId, userId])
  @@map("finance_wallets")
}

/// One token balance of one wallet on one chain. Replaced on every crypto sync; not cash.
model FinanceCryptoHolding {
  id            String        @id @default(cuid())
  spaceId       String
  userId        String
  walletId      String
  wallet        FinanceWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  chainId       Int
  /// Lowercase contract address; "" for the chain's native coin.
  tokenAddress  String
  symbol        String
  name          String
  decimals      Int
  /// uint256 as a decimal string; never a float.
  rawBalance    String
  /// USD per whole token as a decimal string; null when Blockscout has no price.
  usdPrice      String?
  /// rawBalance x usdPrice in whole cents, rounded half up; null when unpriced.
  usdValueCents BigInt?
  syncedAt      DateTime

  @@unique([walletId, chainId, tokenAddress])
  @@index([spaceId, userId])
  @@map("finance_crypto_holdings")
}

/// Per user and space: what counts as cash for runway. "bank" (default) | "stablecoins" | "all".
model FinancePreference {
  id           String   @id @default(cuid())
  spaceId      String
  userId       String
  runwayCrypto String   @default("bank")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([spaceId, userId])
  @@map("finance_preferences")
}

/// One wallet's priced crypto value for one UTC day, rewritten by every sync that day (the last value wins).
model FinanceCryptoSnapshot {
  id               String        @id @default(cuid())
  spaceId          String
  userId           String
  walletId         String
  wallet           FinanceWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  /// UTC day, YYYY-MM-DD.
  day              String
  stablecoinCents  BigInt
  otherCryptoCents BigInt
  updatedAt        DateTime      @updatedAt

  @@unique([walletId, day])
  @@index([spaceId, userId, day])
  @@map("finance_crypto_snapshots")
}

/// A read-only Coinbase or Kraken API-key connection. The key lives encrypted in `secrets` (secretId).
model FinanceExchangeConnection {
  id           String                    @id @default(cuid())
  spaceId      String
  userId       String
  /// "coinbase" | "kraken"
  provider     String
  secretId     String
  /// Last successful sync; null until the first one, so the connection is not yet "connected".
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  balances     FinanceExchangeBalance[]
  snapshots    FinanceExchangeSnapshot[]

  @@unique([spaceId, userId, provider])
  @@map("finance_exchange_connections")
}

/// One asset balance on one exchange, replaced on every sync. Amount and price are decimal strings.
model FinanceExchangeBalance {
  id            String                    @id @default(cuid())
  spaceId       String
  userId        String
  connectionId  String
  connection    FinanceExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  asset         String
  amount        String
  usdPrice      String?
  /// Whole USD cents; null when unpriced.
  usdValueCents BigInt?
  /// "stablecoin" (USD stablecoins and USD cash) | "other"
  bucket        String
  syncedAt      DateTime

  @@unique([connectionId, asset])
  @@index([spaceId, userId])
  @@map("finance_exchange_balances")
}

/// Daily exchange value per connection, like finance_crypto_snapshots is for wallets.
model FinanceExchangeSnapshot {
  id               String                    @id @default(cuid())
  spaceId          String
  userId           String
  connectionId     String
  connection       FinanceExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// UTC day, YYYY-MM-DD.
  day              String
  stablecoinCents  BigInt
  otherCryptoCents BigInt
  updatedAt        DateTime                  @updatedAt

  @@unique([connectionId, day])
  @@index([spaceId, userId, day])
  @@map("finance_exchange_snapshots")
}

model Contact {
  id               String                @id @default(cuid())
  spaceId          String
  space            Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  /// For example the investor's fund.
  organization     String?
  /// A ContactKind: "investor", "auditor", "customer", "vendor", "partner", "advisor", "legal", "prospect" or "other"
  kind             String                @default("investor")
  notes            String?
  /// Prospect pipeline stage: target, intro, meeting, diligence, committed or passed; null for other contacts.
  stage            String?
  checkSizeCents   BigInt?
  nextStep         String?
  /// The round open when the prospect's stage was last saved as committed; null otherwise.
  roundId          String?
  round            FundraiseRound?       @relation(fields: [roundId], references: [id], onDelete: SetNull)
  /// Investor portal: when a link was last issued, when it was last opened, and when access was revoked.
  portalLinkSentAt DateTime?
  portalLastSeenAt DateTime?
  portalBlockedAt  DateTime?
  /// When Send SAFE opened Mercury; null when the prospect is not waiting for a Mercury SAFE.
  mercurySentAt    DateTime?
  shares           InvestorShare[]
  portalTokens     InvestorPortalToken[]
  portalSessions   PortalSession[]
  safes            Safe[]
  /// The agent that added the contact, set by the server; null for a contact added by hand or after the agent was deleted.
  botId            String?
  bot              Bot?                  @relation(fields: [botId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  companyEntities CompanyEntity[] @relation("CompanyEntityContact")

  @@unique([spaceId, userId, email])
  @@unique([id, spaceId, userId])
  @@index([spaceId, userId])
  @@index([botId])
  @@index([roundId])
  @@map("contacts")
}

/// A Data room document one investor contact may download from the portal.
model InvestorShare {
  id             String       @id @default(cuid())
  spaceId        String
  space          Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dataRoomItemId String
  dataRoomItem   DataRoomItem @relation(fields: [dataRoomItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([contactId, dataRoomItemId])
  @@index([spaceId, userId])
  @@index([dataRoomItemId])
  @@map("investor_shares")
}

/// A portal link. Only the sha256 of the token is stored; the token is in the link fragment.
model InvestorPortalToken {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([contactId])
  @@map("investor_portal_tokens")
}

/// An open portal session. The cookie holds a random value; only its sha256 is stored.
model PortalSession {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([contactId])
  @@map("portal_sessions")
}

/// An update to investors or the board. Draft, then sending, then sent. A sent update is read-only.
model InvestorUpdate {
  id                  String    @id @default(cuid())
  spaceId             String
  space               Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "investors" | "board"
  audience            String
  subject             String
  /// YYYY-MM or YYYY-Qn
  period              String
  /// Markdown.
  body                String    @default("")
  /// "draft" | "sending" | "sent" | "posted". Partly sent is derived from the deliveries.
  status              String    @default("draft")
  recipientContactIds String[]
  fromConnectionId    String?
  /// { [contactId]: [{ n, at, delivered? }] }. The outcome of attempt n is the ComposeSend row whose clientId is `<id>:<contactId>:<n>`.
  deliveries          Json      @default("{}")
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  /// Moves on every recorded delivery, so a sending update with no movement for 10 minutes reads Partly sent.
  updatedAt           DateTime  @updatedAt

  @@index([spaceId, userId, createdAt])
  @@map("investor_updates")
}

/// An auditor, 409A or DocuSign request. Created by the mail intake job the moment the mail arrives
/// (so it shows even if drafting never starts), or by the Investors agent for a request that did not
/// arrive by mail. Only the founder closes it (done or dismissed); a dismissed row keeps its thread.
/// audit_requests_agent_open_key is raw SQL, a partial unique index over the agent-added rows.
model AuditRequest {
  id             String    @id @default(cuid())
  spaceId        String
  space          Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The subject line until the agent corrects it.
  fund           String
  /// Lower case, single spaces: how the agent's upsert finds the same request again.
  fundKey        String
  asOf           DateTime? @db.Date
  /// False when the statement had to use current holdings.
  asOfMatched    Boolean   @default(true)
  dueDate        DateTime? @db.Date
  /// "open" | "drafted" | "done" | "dismissed"
  status         String    @default("open")
  dataRoomItemId String?
  mailThreadId   String?
  connectionId   String?
  /// Gmail draft id.
  draftRef       String?
  /// The sender is an Auditor contact.
  senderKnown    Boolean   @default(false)
  notes          String    @default("")
  draftStartedAt DateTime?
  draftedAt      DateTime?
  doneAt         DateTime?
  /// The newest mail in the thread; later than draftedAt means New mail.
  lastMailAt     DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([spaceId, userId, mailThreadId])
  @@index([spaceId, userId, status])
  @@index([spaceId, userId, draftStartedAt])
  @@map("audit_requests")
}

/// A fundraising round. Open while closedAt is null; at most one open round per space and user
/// (fundraise_rounds_open_key is raw SQL, a partial unique index).
model FundraiseRound {
  id          String    @id @default(cuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  targetCents BigInt
  capCents    BigInt
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contacts    Contact[]
  safes       Safe[]

  @@index([spaceId, userId])
  @@map("fundraise_rounds")
}

/// A SAFE. A native row is the founder's own record of a YC post-money cap SAFE they send themselves;
/// its status is derived from the dates (packages/core/src/safes.ts), never stored.
model Safe {
  id                   String              @id @default(cuid())
  spaceId              String
  space                Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "native" | "mercury"
  source               String              @default("native")
  /// Mercury's id; null on a native row.
  externalId           String?
  contactId            String?
  contact              Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  roundId              String?
  round                FundraiseRound?     @relation(fields: [roundId], references: [id], onDelete: SetNull)
  investorName         String
  investorEmail        String?
  amountCents          BigInt
  /// "post_money_cap" on every native row.
  valuationType        String              @default("post_money_cap")
  capCents             BigInt?
  discountPercent      Float?
  mfn                  Boolean             @default(false)
  proRata              Boolean             @default(false)
  governingState       String?
  investmentDate       DateTime?
  expiresAt            DateTime?
  canceledAt           DateTime?
  sentAt               DateTime?
  signedByOwnerAt      DateTime?
  signedByInvestorAt   DateTime?
  paidAt               DateTime?
  documentUrl          String?
  /// Mercury only: the Finance deposit matched to this SAFE. A transaction links to at most one SAFE.
  financeTransactionId String?             @unique
  financeTransaction   FinanceTransaction? @relation(fields: [financeTransactionId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([spaceId, userId, source, externalId])
  @@index([spaceId, userId])
  @@index([contactId])
  @@index([roundId])
  @@map("safes")
}

/// Throttle, claim and last result of the Mercury SAFE sync. One row per space and user; not tied to the
/// MCP server, so removing Mercury changes nothing and reconnecting continues from it.
model SafeSyncState {
  spaceId        String
  space          Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSyncedAt   DateTime?
  /// Claim held by the process that is syncing; stale after 2 minutes.
  syncStartedAt  DateTime?
  claimToken     String?
  lastErrorAt    DateTime?
  /// Short failure reason; never a vendor payload or credential.
  lastError      String?
  needsReconnect Boolean   @default(false)
  /// Rows of the last answer that could not be read.
  unreadable     Int       @default(0)

  @@id([spaceId, userId])
  @@map("safe_sync_states")
}

/// The Carta agent's latest read of the company's cap table. One row per user, replaced on each sync.
model CapTableSnapshot {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CapTableSnapshotInput from @rakazo/contracts.
  data      Json
  /// The only writer allowed to replace the table: carta, sheet or native. Old rows read as carta.
  source    String   @default("carta")
  /// One version back ({ source, sourceRef, data }), written by a source switch and cleared by Undo or the next change.
  previous  Json?
  updatedAt DateTime @updatedAt

  @@unique([spaceId, userId])
  @@map("cap_table_snapshots")
}

/// An optional sidebar page the user added from SIDEBAR_PAGE_TEMPLATES.
model SidebarPage {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateKey String
  position    Int
  createdAt   DateTime @default(now())

  @@unique([spaceId, userId, templateKey])
  @@index([spaceId, userId])
  @@map("sidebar_pages")
}

// Data room. Every row carries spaceId (cascade) and userId; every query filters on spaceId.
// Partial unique indexes, the generated tsv column and the HNSW index live in the migration SQL
// because Prisma cannot express them.
model DataRoomFolder {
  id        String           @id @default(cuid())
  spaceId   String
  space     Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  parentId  String?
  parent    DataRoomFolder?  @relation("DataRoomFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DataRoomFolder[] @relation("DataRoomFolderTree")
  name      String
  /// "user" or "agent".
  createdBy String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     DataRoomItem[]

  @@index([spaceId, parentId])
  @@map("data_room_folders")
}

model DataRoomItem {
  id                 String            @id @default(cuid())
  spaceId            String
  space              Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId             String
  folderId           String?
  folder             DataRoomFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// The import that filed this item, when one did.
  importId           String?
  import             DataRoomImport?   @relation(fields: [importId], references: [id], onDelete: SetNull)
  /// "upload", "drive", "box", "gmail", "chat" or "finance".
  source             String
  sourceConnectionId String?
  sourceConnection   Connection?       @relation(fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  externalId         String?
  sha256             String
  /// Null when the source keeps the bytes.
  storageKey         String?
  name               String
  mimeType           String
  size               BigInt
  sourceUrl          String?
  sourceUpdatedAt    DateTime?
  /// "pending", "extracting", "classifying", "indexing", "ready" or "failed".
  status             String            @default("pending")
  error              String?
  /// True when the file is stored and listed but too large to read for search.
  notIndexed         Boolean           @default(false)
  docType            String?
  docDate            DateTime?
  parties            String[]
  amountCents        BigInt?
  currency           String?
  tags               String[]
  summary            String?
  /// Bumped by every pipeline write; a step writes only if it still matches what the step read.
  revision           Int               @default(0)
  /// Consecutive failed attempts of the current pipeline step; the item fails at the retry limit.
  failures           Int               @default(0)
  /// Set when the classifier filled the facets. Null on a ready item means classification was skipped.
  classifiedAt       DateTime?
  /// Held by the pipeline step that claimed the item; a step starts only when this is null or past.
  leaseUntil         DateTime?
  /// Store key of the small WebP preview of a PDF or image. Null: none made (yet).
  thumbnailKey       String?
  /// Set when a thumbnail job was queued for the item, so one is queued at most once.
  thumbnailTriedAt   DateTime?
  /// The first ~400 characters of the extracted text, for the grid; the full text stays in `text`.
  previewText        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  chunks             DataRoomChunk[]
  text               DataRoomItemText?
  legalContracts     LegalContract[]
  legalEdges         LegalEdge[]
  investorShares     InvestorShare[]
  companyEntities    CompanyEntity[] @relation("CompanyEntityDataRoomItem")
  companyEvidence    CompanyEvidence[] @relation("CompanyEvidenceDataRoomItem")
  companyCandidates  CompanyCandidate[] @relation("CompanyCandidateDataRoomItem")

  @@index([spaceId, folderId])
  @@unique([id, spaceId, userId])
  @@index([importId])
  @@index([spaceId, status])
  @@index([spaceId, userId, createdAt, id])
  @@index([spaceId, userId, docDate, id])
  @@index([spaceId, userId, name, id])
  @@index([spaceId, userId, docType, id])
  @@index([parties], type: Gin)
  @@index([tags], type: Gin)
  @@map("data_room_items")
}

/// One reversible change a Data room tidy-up made. Rows of one batch share `batchId`; undo walks them
/// newest first. Nothing here deletes an item: a folder is deleted only when a merge emptied it.
model DataRoomChange {
  id        String    @id @default(cuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  batchId   String
  /// Order within the batch.
  seq       Int
  /// "create_folder", "delete_folder", "move_folder", "move_item" or "rename_item".
  kind      String
  /// The folder or item the change touched.
  targetId  String
  before    Json
  after     Json
  /// "user" or "agent".
  actor     String    @default("user")
  createdAt DateTime  @default(now())
  undoneAt  DateTime?

  @@index([spaceId, userId, batchId, seq])
  @@map("data_room_changes")
}

/// One import of files into the Data room (Drive, Box or email). It finishes when every file is ready,
/// failed, or was skipped; `notifiedAt` makes the finish notification happen once.
model DataRoomImport {
  id          String         @id @default(cuid())
  spaceId     String
  space       Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  /// "drive", "box", "gmail" or "upload" (a zip unpacked after upload).
  source      String
  /// Files the import set out to file, including the ones skipped below.
  total       Int
  /// Files already in the Data room; they count as done.
  duplicates  Int            @default(0)
  /// Files that never became an item (gone, unsupported, too large); they count as failed.
  rejected    Int            @default(0)
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?
  notifiedAt  DateTime?
  /// A zip import's step for the upload card: "opening", "adding", "reading" or "done".
  stage       String?
  /// The zip entry being added, while stage is "adding".
  currentName String?
  items       DataRoomItem[]

  @@index([spaceId, userId, createdAt])
  @@map("data_room_imports")
}

/// Extracted document text, kept apart from the item so lists never load it. Lets indexing run
/// again (new embedding model, consent granted) without reading the blob or calling vision again.
model DataRoomItemText {
  itemId     String       @id
  item       DataRoomItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  spaceId    String
  space      Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  text       String
  /// What the read depended on (vision model, consent); see `dataRoomVisionKey`. Null: saved before this was recorded.
  extractKey String?

  @@index([spaceId, userId])
  @@map("data_room_item_texts")
}

model DataRoomChunk {
  id          String                   @id @default(cuid())
  spaceId     String
  space       Space                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  itemId      String
  item        DataRoomItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ordinal     Int
  text        String
  contentHash String
  /// GENERATED ALWAYS AS (to_tsvector('english', text)) STORED.
  tsv         Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, text)"))

  embedding      Unsupported("vector(1024)")?
  embeddingModel String?

  @@unique([itemId, ordinal])
  @@index([tsv], type: Gin)
  @@index([spaceId, userId])
  @@map("data_room_chunks")
}

/// One member's Data room settings. No row means the defaults: everything on.
model DataRoomPreference {
  spaceId       String
  userId        String
  spaceMember   SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// Sync files the qualifying attachments of new mail into the Data room.
  autoFileEmail Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  @@id([spaceId, userId])
  @@map("data_room_preferences")
}

/// Sync throttle and in-flight claim for one source connection (the MailSyncState pattern).
model DataRoomSyncState {
  connectionId String     @id
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  spaceId      String
  space        Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String
  /// Provider change cursor (Drive page token, Gmail historyId).
  cursor       String?
  lastSyncedAt DateTime?
  /// Claim held by the process that is syncing; stale after 2 minutes.
  claimedAt    DateTime?
  /// Random id of the sync holding the claim; every write checks it.
  claimToken   String?
  /// Short failure reason; never a vendor payload or credential.
  error        String?

  @@index([spaceId])
  @@map("data_room_sync_states")
}

/// What the Legal agent concluded about one Data Room item. The document itself stays in the Data Room.
model LegalContract {
  id                String          @id @default(cuid())
  spaceId           String
  userId            String
  dataRoomItemId    String
  item              DataRoomItem    @relation(fields: [dataRoomItemId], references: [id], onDelete: Cascade)
  title             String
  contractType      String
  counterparties    String[]
  /// "active" | "expired" | "terminated" | "draft" | "unknown"
  status            String
  effectiveDate     DateTime?       @db.Date
  expirationDate    DateTime?       @db.Date
  autoRenews        Boolean?
  renewalNoticeDays Int?
  governingLaw      String?
  /// Integer minor units, like DataRoomItem.amountCents.
  valueCents        BigInt?
  currency          String?
  summary           String?
  /// DataRoomItem.revision the analysis was made at; a higher revision means it needs review again.
  analyzedRevision  Int
  analyzedAt        DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deadlines         LegalDeadline[]
  nodes             LegalNode[]
  companyEntities   CompanyEntity[] @relation("CompanyEntityLegalContract")

  @@unique([spaceId, userId, dataRoomItemId])
  @@unique([id, spaceId, userId])
  @@index([spaceId, userId, expirationDate])
  @@map("legal_contracts")
}

model LegalDeadline {
  id             String         @id @default(cuid())
  spaceId        String
  userId         String
  contractId     String?
  contract       LegalContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  dataRoomItemId String?
  title          String
  dueDate        DateTime       @db.Date
  /// "renewal" | "notice" | "termination" | "payment" | "filing" | "compliance" | "other"
  kind           String
  /// "open" | "done" | "dismissed"
  status         String         @default("open")
  /// Opened by legal_upsert_contract from the contract's dates; re-derived (not hand-made) when they change.
  derived        Boolean        @default(false)
  /// Set when a scan finds the deadline no longer applies; only the founder dismisses it (or keeps it, which clears this).
  removalProposedAt DateTime?
  sourceQuote    String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([spaceId, userId, status, dueDate])
  @@index([contractId])
  @@map("legal_deadlines")
}

/// A party, contract, obligation, right, asset or jurisdiction in the legal graph.
model LegalNode {
  id         String         @id @default(cuid())
  spaceId    String
  userId     String
  /// "company" | "person" | "contract" | "obligation" | "right" | "asset" | "jurisdiction" | "other"
  kind       String
  label      String
  /// Normalized label; with kind it identifies the node, so the agent can upsert it again.
  key        String
  attrs      Json?
  contractId String?
  contract   LegalContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  edgesOut   LegalEdge[]    @relation("LegalEdgeFrom")
  edgesIn    LegalEdge[]    @relation("LegalEdgeTo")

  @@unique([spaceId, userId, kind, key])
  @@index([spaceId, userId])
  @@index([contractId])
  @@map("legal_nodes")
}

model LegalEdge {
  id             String        @id @default(cuid())
  spaceId        String
  userId         String
  fromId         String
  from           LegalNode     @relation("LegalEdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId           String
  to             LegalNode     @relation("LegalEdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  /// A short verb: party_to, owes, grants, governed_by, owns, signed_by.
  relation       String
  /// The evidence item; deleting it removes the edge.
  dataRoomItemId String?
  dataRoomItem   DataRoomItem? @relation(fields: [dataRoomItemId], references: [id], onDelete: Cascade)
  sourceQuote    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([fromId, toId, relation])
  @@index([spaceId, userId])
  @@index([toId])
  @@index([dataRoomItemId])
  @@map("legal_edges")
}

/// A user's "Export my data" zip. At most one pending or running row per user (partial unique index
/// account_exports_one_active_key in the migration SQL). The zip lives in the artifact store under
/// `storageKey`, scoped to `spaceId`; the row and the blob are removed once `expiresAt` passes.
model AccountExport {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The space whose blob scope holds the zip.
  spaceId    String
  /// "pending", "running", "ready" or "failed".
  status     String   @default("pending")
  /// 0 to 100.
  progress   Int      @default(0)
  storageKey String?
  size       BigInt?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("account_exports")
}
/// Pending "Sign in with OpenRouter" attempt: the state is the id, the PKCE verifier is encrypted.
model ModelOAuthState {
  id                 String   @id
  userId             String
  spaceId            String
  provider           String
  verifierCiphertext String
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([userId, spaceId, provider])
  @@map("model_oauth_states")
}

/// The space's one active Devin connection: lease, backoff and health for the refresh operation.
model DevinConnectionState {
  serverId        String    @id
  server          McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// One active connection per space.
  spaceId         String    @unique
  /// Fence: bumped on every claim and every management write.
  version         Int       @default(0)
  leaseToken      String?
  leaseUntil      DateTime?
  /// Null until the first successful refresh, and again after a key replacement.
  lastSucceededAt DateTime?
  complete        Boolean   @default(false)
  skipped         Int       @default(0)
  backoffUntil    DateTime?
  backoffStep     Int       @default(0)
  /// 401, or 403 on the listing; refresh stops until the key is replaced.
  rejectedAt      DateTime?
  /// rejected | connector_gone | unreachable | rate_limited
  lastError       String?

  @@map("devin_connection_states")
}

/// The last-seen state of one Devin session, read by the page and the alert step.
model DevinSession {
  id                String    @id @default(cuid())
  serverId          String
  server            McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  spaceId           String
  sessionId         String
  title             String
  status            String
  statusDetail      String?
  kind              String
  /// At most 500 characters.
  question          String?
  prs               Json      @default("[]")
  origin            String
  devinUpdatedAt    DateTime
  /// Devin's latest message event_id, when read.
  lastMessageId     String?
  /// The identity the last alert was sent for.
  notifiedMessageId String?
  lastSeenAt        DateTime

  @@unique([serverId, sessionId])
  @@index([spaceId, kind])
  @@map("devin_sessions")
}

// Meetings. Private to the user who connected the source; every query filters on spaceId and userId.
// The generated tsv column, its GIN index and the one-source CHECK live in the migration SQL.
model Meeting {
  id                String                   @id @default(cuid())
  spaceId           String
  space             Space                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// At most one of connectionId and mcpServerId; the meeting outlives its source.
  connectionId      String?
  connection        Connection?              @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  mcpServerId       String?
  mcpServer         McpServer?               @relation(fields: [mcpServerId], references: [id], onDelete: SetNull)
  provider          String
  externalId        String
  title             String
  startedAt         DateTime
  endedAt           DateTime?
  /// { name?: string, email?: string }[]
  attendees         Json                     @default("[]")
  organizerEmail    String?
  sourceUrl         String?
  folders           String[]                 @default([])
  summary           String                   @default("")
  privateNotes      String                   @default("")
  /// Speaker-prefixed lines.
  transcript        String?
  transcriptIndexed Boolean                  @default(false)
  digest            Json?
  digestStatus      String?
  sourceUpdatedAt   DateTime
  /// Only for providers that report deletions.
  deletedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  /// GENERATED ALWAYS AS (to_tsvector('english', title || summary || transcript)) STORED; see the migration.
  tsv               Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((((title || ' '::text) || summary) || ' '::text) || COALESCE(transcript, ''::text)))"))
  inboxTodos        InboxTodo[]

  @@unique([spaceId, userId, provider, externalId])
  @@index([spaceId, userId, startedAt])
  @@index([tsv], type: Gin)
  @@map("meetings")
}

/// One row per source; may be deleted with its source, meetings are not.
model MeetingSyncState {
  id                String      @id @default(cuid())
  spaceId           String
  space             Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId      String?     @unique
  connection        Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  mcpServerId       String?     @unique
  mcpServer         McpServer?  @relation(fields: [mcpServerId], references: [id], onDelete: SetNull)
  provider          String
  /// The provider's user id, stored on first sync so a different account is rejected.
  externalAccountId String?
  cursor            String?
  syncedThrough     DateTime?
  claimedAt         DateTime?
  claimToken        String?
  lastSyncedAt      DateTime?
  /// Short reason, never a vendor payload.
  error             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("meeting_sync_states")
}

/// A meeting the user deleted; sync skips it so it does not come back.
model MeetingTombstone {
  id         String   @id @default(cuid())
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([spaceId, userId, provider, externalId])
  @@map("meeting_tombstones")
}
model CompanyEntity {
  id                String          @id @default(cuid())
  spaceId           String
  space             Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId       String
  owner             SpaceMember     @relation(fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  kind              String
  displayName       String
  normalizedName    String
  attrs             Json            @default("{}")
  confidence        Float
  status            String          @default("suggested")
  visibility        String          @default("private")
  lockedFields      String[]        @default([])
  sourceClaimKeys   String[]        @default([])
  confirmedAt       DateTime?
  confirmedByUserId String?
  contactId         String?
  contact           Contact?        @relation("CompanyEntityContact", fields: [contactId, spaceId, ownerUserId], references: [id, spaceId, userId], onDelete: SetNull)
  legalContractId   String?
  legalContract     LegalContract?  @relation("CompanyEntityLegalContract", fields: [legalContractId, spaceId, ownerUserId], references: [id, spaceId, userId], onDelete: SetNull)
  dataRoomItemId    String?
  dataRoomItem      DataRoomItem?   @relation("CompanyEntityDataRoomItem", fields: [dataRoomItemId, spaceId, ownerUserId], references: [id, spaceId, userId], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  identities        CompanyIdentity[]
  edgesOut          CompanyEdge[]   @relation("CompanyEdgeFrom")
  edgesIn           CompanyEdge[]   @relation("CompanyEdgeTo")
  eventLinks        CompanyEventEntity[]
  mergesFrom        CompanyMerge[]  @relation("CompanyMergeSource")
  mergesInto        CompanyMerge[]  @relation("CompanyMergeSurvivor")
  corrections       CompanyCorrection[]

  @@unique([id, spaceId, ownerUserId])
  @@index([spaceId, ownerUserId, kind, status])
  @@index([spaceId, ownerUserId, normalizedName])
  @@map("company_entities")
}

model CompanyIdentity {
  id             String        @id @default(cuid())
  spaceId        String
  space          Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId    String
  owner          SpaceMember   @relation(fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  entityId       String
  entity         CompanyEntity @relation(fields: [entityId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  entityKind     String
  identityType   String
  identityValue  String
  createdAt      DateTime      @default(now())

  @@unique([id, spaceId, ownerUserId])
  @@unique([spaceId, ownerUserId, entityKind, identityType, identityValue])
  @@index([entityId, spaceId, ownerUserId])
  @@map("company_identities")
}

model CompanyEdge {
  id             String        @id @default(cuid())
  spaceId        String
  space          Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId    String
  owner          SpaceMember   @relation(fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  fromId         String
  fromEntity     CompanyEntity @relation("CompanyEdgeFrom", fields: [fromId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  toId           String
  toEntity       CompanyEntity @relation("CompanyEdgeTo", fields: [toId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  relation       String
  startsOn       DateTime?     @db.Date
  startsPrecision String?
  endsOn         DateTime?     @db.Date
  endsPrecision  String?
  role           String?
  confidence     Float
  status         String          @default("suggested")
  visibility     String          @default("private")
  lockedFields   String[]        @default([])
  claimFingerprints String[]     @default([])
  confirmedByUserId String?
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([id, spaceId, ownerUserId])
  @@index([spaceId, ownerUserId, fromId])
  @@index([spaceId, ownerUserId, toId])
  @@map("company_edges")
}

model CompanyEvent {
  id               String             @id @default(cuid())
  spaceId          String
  space            Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId      String
  owner            SpaceMember        @relation(fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  stream           String
  kind             String
  title            String
  normalizedTitle  String
  occursOn         DateTime?          @db.Date
  occursPrecision  String?
  endsOn           DateTime?          @db.Date
  endsPrecision    String?
  amountCents      BigInt?
  currency         String?
  confidence       Float
  status           String             @default("suggested")
  visibility       String             @default("private")
  lockedFields     String[]           @default([])
  claimFingerprints String[]          @default([])
  sourceClaimKeys  String[]           @default([])
  subjectKey       String
  confirmedByUserId String?
  confirmedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  entityLinks      CompanyEventEntity[]

  @@unique([id, spaceId, ownerUserId])
  @@index([spaceId, ownerUserId, occursOn])
  @@map("company_events")
