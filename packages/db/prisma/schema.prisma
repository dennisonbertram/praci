/// A saved mail_search result, readable by mail_grep until `expiresAt`. Scoped to one bot of one user.
model MailSearch {
  id        String          @id @default(cuid())
  spaceId   String
  space     Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot             @relation(fields: [botId], references: [id], onDelete: Cascade)
  /// The object mail_search returned, minus searchId.
  summary   Json
  /// [{ accountId, query, unhydratedIds, pageToken? }] for queries that stopped early; null when complete.
  resume    Json?
  createdAt DateTime        @default(now())
  expiresAt DateTime
  rows      MailSearchRow[]

  @@index([spaceId, userId, botId])
  @@index([expiresAt])
  @@map("mail_searches")
}

