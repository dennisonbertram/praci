  event       CompanyEvent  @relation(fields: [eventId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  entityId    String
  entity      CompanyEntity @relation(fields: [entityId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)

  @@unique([id, spaceId, ownerUserId])
  @@unique([eventId, entityId])
  @@map("company_event_entities")
}

model CompanyEvidence {
  id              String        @id @default(cuid())
  spaceId         String
  space           Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId     String
  owner           SpaceMember   @relation(fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  factKind        String
  factId          String
  stance          String        @default("supports")
  sourceKind      String
  connectionId    String?
  connection      Connection?   @relation(fields: [connectionId, spaceId, ownerUserId], references: [id, spaceId, userId], onDelete: SetNull)
  mcpServerId     String?
  mcpServer       McpServer?    @relation(fields: [mcpServerId, spaceId, ownerUserId], references: [id, spaceId, userId], onDelete: SetNull)
  dataRoomItemId  String?
  dataRoomItem    DataRoomItem? @relation("CompanyEvidenceDataRoomItem", fields: [dataRoomItemId, spaceId, ownerUserId], references: [id, spaceId, userId], onDelete: SetNull)
  sourceItemId    String
  sourceKey       String
  sourceUrl       String?
  quote           String
  contentHash     String
  extractedAt     DateTime
  extractorRunId  String?
  extractorModel  Json?
  confidence      Float
  confirmedByUserId String?
  confirmedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt       DateTime      @default(now())
  importObservations CompanyImportEvidence[]

  @@unique([id, spaceId, ownerUserId])
  @@unique([spaceId, ownerUserId, factKind, factId, sourceKey, contentHash])
  @@index([spaceId, ownerUserId, sourceKind, sourceItemId])
  @@index([factKind, factId, spaceId, ownerUserId])
  @@map("company_evidence")
}

model CompanyCandidate {
