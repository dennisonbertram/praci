model Artifact {
  id          String     @id @default(cuid())
  spaceId     String
  space       Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId       String?
  bot         Bot?       @relation(fields: [botId], references: [id], onDelete: SetNull)
  groupId     String?
  group       ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  runId       String?
  name        String
  description String?
  mimeType    String
  size        Int
  hash        String
  storageKey  String
  createdAt   DateTime   @default(now())

  // Null on the first version; that row's id is the family's stable id.
  rootArtifactId String?
  rootArtifact   Artifact?  @relation("ArtifactVersions", fields: [rootArtifactId], references: [id], onDelete: Cascade)
  versions       Artifact[] @relation("ArtifactVersions")
  version        Int        @default(1)
  // Client-chosen per upload so a retried upload that already landed returns this row.
  clientNonce    String?

  @@unique([spaceId, userId, clientNonce])
  @@index([spaceId, botId])
  @@index([groupId])
  @@index([rootArtifactId])
  // artifacts_family_version_key is raw SQL: Prisma cannot express COALESCE indexes.
  @@map("artifacts")
}

model UsageRecord {
  id                 String   @id @default(cuid())
  spaceId            String
  space              Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Which bot spent this. Deliberately NOT a relation: a usage row is spend that really
  /// happened, and no lifecycle event on the bot may delete it or blank its attribution.
  /// `Cascade` erased the row; `SetNull` would erase the attribution instead, and because
  /// deleting a bot also deletes its runs, `runId` goes null in the same breath — the row
  /// would keep only space, user, model and token counts.
  ///
  /// So the id outlives the bot and may dangle. Read it with a LEFT JOIN; `BotDeletion.id`
  /// IS the bot id, so a deleted bot's name is still reachable for display.
  botId              String?
  userId             String
  runId              String?
  run                Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  provider           String
  model              String
  /// Uncached input; cache buckets are additional, reasoning is a subset of output.
  inputTokens        Int?
  outputTokens       Int?
  cacheReadTokens    Int?
  cacheWriteTokens   Int?
  cacheWrite1hTokens Int?
  reasoningTokens    Int?
  totalTokens        Int?
  costUsd            Float?
  costSource         String?
  pricingVersion     String?
  usageSource        String?
  callId             String?  @unique
  operationId        String?
  operationKind      String   @default("answer")
  /// Durable attribution, deliberately without lifecycle foreign keys.
  parentRunId        String?
  agentId            String?
  createdAt          DateTime @default(now())

  @@index([spaceId, userId, createdAt])
  @@map("usage_records")
}

model NotificationPreference {
  id       String  @id @default(cuid())
  spaceId  String
  space    Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  finish   Boolean @default(true)
  help     Boolean @default(true)
  takeover Boolean @default(true)
  // Per external channel switches, for example {"push": false}. A missing key means enabled.
  channels Json    @default("{}")

  @@unique([spaceId, userId])
  @@map("notification_preferences")
}

enum NotificationImportance {
  info
  attention
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
  skipped
}

// Something an agent tells the user. Scoped to space and user. botId, routineId and runId are
// plain ids so a deleted agent does not delete the history; the 30 day retention removes the rows.
model Notification {
  id         String                 @id @default(cuid())
  spaceId    String
  space      Space                  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId      String?
  routineId  String?
  runId      String?
  surface    String
  threadId   String?
  title      String
  body       String?
  link       String?
  importance NotificationImportance @default(info)
  /// Sidebar status icon: urgent, needs_input, failed, done or new. Null on older rows (falls back to importance).
  kind       String?
  dedupeKey  String
  createdAt  DateTime               @default(now())
  seenAt     DateTime?
  shownAt    DateTime?
  /// The person closed this approval's toast with X; it is no longer restored.
  dismissedAt DateTime?
  deliveries NotificationDelivery[]

  @@index([spaceId, userId, botId, dedupeKey, createdAt])
  @@index([spaceId, userId, seenAt])
  @@index([spaceId, userId, botId, seenAt])
  @@index([spaceId, userId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String
  status         NotificationDeliveryStatus @default(pending)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime
  lastError      String?
  createdAt      DateTime                   @default(now())

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

// Where a channel reaches a user: an Expo push token per device today. spaceId is null for
// account-wide addresses.
model NotificationEndpoint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String?
  space     Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  channel   String
  address   String
  deviceId  String
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channel, deviceId])
