  dataRoomSyncState   DataRoomSyncState?
  dataRoomItems       DataRoomItem[]
  composeSends        ComposeSend[]
  /// false: only bots with a BotConnectionAccess row may use this connection's tools.
  allAgents           Boolean               @default(true)
  botAccess           BotConnectionAccess[]
