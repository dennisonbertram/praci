  claimKey    String?
  createdAt   DateTime    @default(now())

  @@unique([spaceId, ownerUserId, sourceKey, reason])
  @@index([spaceId, ownerUserId, factKind, factId])
  @@index([spaceId, ownerUserId, claimKey])
  @@map("company_candidate_resolutions")
}

model CompanyCorrection {
  id          String        @id @default(cuid())
  spaceId     String
  space       Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId String
  owner       SpaceMember   @relation(fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  entityId    String
  entity      CompanyEntity @relation(fields: [entityId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  fieldPath   String
  value       Json
  evidenceId  String?
  createdAt   DateTime      @default(now())

  @@unique([id, spaceId, ownerUserId])
  @@index([spaceId, ownerUserId, entityId, fieldPath])
  @@map("company_corrections")
}

model CompanyRejection {
  id              String      @id @default(cuid())
  spaceId         String
  space           Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId     String
  owner           SpaceMember @relation(fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  factKind        String      @default("entity")
  entityKind      String?
  fingerprint     String
  identityAliases String[]
  reason          String?
  excludedPerson  Boolean     @default(false)
  createdAt       DateTime    @default(now())

  @@unique([id, spaceId, ownerUserId])
  @@unique([spaceId, ownerUserId, fingerprint])
  @@index([spaceId, ownerUserId])
  @@map("company_rejections")
}

model CompanySourceBlock {
  id          String      @id @default(cuid())
  spaceId     String
  space       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId String
  owner       SpaceMember @relation(fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  sourceKey   String
  sourceKind  String
  connectionId String?
  mcpServerId String?
  createdAt   DateTime    @default(now())

  @@unique([spaceId, ownerUserId, sourceKey])
  @@index([spaceId, ownerUserId, sourceKind])
  @@map("company_source_blocks")
}

model CompanyMerge {
  id               String        @id @default(cuid())
  spaceId          String
  space            Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId      String
  owner            SpaceMember   @relation(fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  sourceEntityId   String
  sourceEntity     CompanyEntity @relation("CompanyMergeSource", fields: [sourceEntityId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  survivorEntityId String
  survivorEntity  CompanyEntity @relation("CompanyMergeSurvivor", fields: [survivorEntityId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  createdAt        DateTime      @default(now())

  @@unique([id, spaceId, ownerUserId])
  @@unique([spaceId, ownerUserId, sourceEntityId])
  @@index([spaceId, ownerUserId, survivorEntityId])
  @@map("company_merges")
}
model CompanyImportRun {
  id                    String                  @id @default(cuid())
  spaceId               String
  space                 Space                   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId           String
  owner                 SpaceMember             @relation("CompanyImportRunOwner", fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  status                String                  @default("draft")
  mode                  String                  @default("full")
  tokenCap              BigInt
  reservedTokens        BigInt                  @default(0)
  inputTokensUsed       BigInt                  @default(0)
  outputTokensUsed      BigInt                  @default(0)
  disclosureVersion     String
  createdAt             DateTime                @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  notificationStates    String[]                @default([])
  notificationPendingStates String[]             @default([])
  updatedAt             DateTime                @updatedAt
  sources               CompanyImportSource[]
  units                 CompanyImportUnit[]
  calls                 CompanyImportCall[]
  candidates            CompanyCandidate[]
  evidenceObservations  CompanyImportEvidence[]
  candidateObservations CompanyImportCandidate[]

  @@unique([id, spaceId, ownerUserId])
  @@index([spaceId, ownerUserId, createdAt])
  @@index([status, updatedAt])
  @@map("company_import_runs")
}

model CompanyImportEvidence {
  id         String           @id @default(cuid())
  runId      String
  run        CompanyImportRun @relation(fields: [runId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  evidenceId String
  evidence   CompanyEvidence  @relation(fields: [evidenceId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  spaceId    String
  ownerUserId String
  createdAt  DateTime         @default(now())

  @@unique([runId, evidenceId])
  @@index([spaceId, ownerUserId, evidenceId])
  @@map("company_import_evidence")
}

model CompanyImportCandidate {
  id          String           @id @default(cuid())
  runId       String
  run         CompanyImportRun @relation(fields: [runId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  candidateId String
  candidate   CompanyCandidate @relation(fields: [candidateId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  spaceId     String
  ownerUserId String
  createdAt   DateTime         @default(now())

  @@unique([runId, candidateId])
  @@index([spaceId, ownerUserId, candidateId])
  @@map("company_import_candidates")
}

model CompanyImportSource {
  id                  String             @id @default(cuid())
  runId               String
  run                 CompanyImportRun   @relation(fields: [runId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  spaceId             String
  space               Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId         String
  owner               SpaceMember        @relation("CompanyImportSourceOwner", fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  sourceKey           String
  sourceKind          String
  connectionId        String?
  mcpServerId         String?
  scope               Json               @default("{}")
  plan                Json               @default("{}")
  cursor              Json?
  baseCheckpoint     Json?
  proposedCheckpoint Json?
  baseCheckpointGeneration Int?
  refreshSourceId    String?
  refreshSource      CompanyRefreshSource? @relation(fields: [refreshSourceId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  sampled            Boolean            @default(false)
  status              String             @default("waiting")
  concurrency         Int                @default(1)
  tokensReserved      BigInt             @default(0)
  inputTokensUsed     BigInt             @default(0)
  outputTokensUsed    BigInt             @default(0)
  backoffUntil        DateTime?
  lastError           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  units               CompanyImportUnit[]
  calls               CompanyImportCall[]

  @@unique([id, spaceId, ownerUserId])
  @@unique([runId, sourceKey])
  @@index([spaceId, ownerUserId, runId, status])
  @@index([mcpServerId])
  @@map("company_import_sources")
}

model CompanyRefreshSource {
  id                  String        @id @default(cuid())
  spaceId             String
  space               Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId         String
  owner               SpaceMember   @relation("CompanyRefreshSourceOwner", fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  sourceKey           String
  sourceKind          String
  connectionId        String?
  mcpServerId         String?
  scope               Json          @default("{}")
  tokenCap            BigInt
  capability          String        @default("pending")
  status              String        @default("needs_baseline")
  reason              String?
  committedCheckpoint Json?
  checkpointGeneration Int          @default(0)
  lastSuccessAt       DateTime?
  nextRunAt           DateTime?
  timezone            String        @default("UTC")
  activeRunId         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  importSources       CompanyImportSource[]

  @@unique([id, spaceId, ownerUserId])
  @@unique([spaceId, ownerUserId, sourceKey])
  @@index([spaceId, ownerUserId, nextRunAt])
  @@index([activeRunId])
  @@map("company_refresh_sources")
}

model CompanyImportUnit {
  id                String             @id @default(cuid())
  runId             String
  run               CompanyImportRun   @relation(fields: [runId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  sourceId          String
  source            CompanyImportSource @relation(fields: [sourceId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  spaceId           String
  space             Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId       String
  owner             SpaceMember        @relation("CompanyImportUnitOwner", fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  unitKey           String
  cursor            Json?
  status            String             @default("waiting")
  attempts          Int                @default(0)
  claimToken        String?
  claimExpiresAt    DateTime?
  availableAt       DateTime            @default(now())
  itemsDiscovered   Int                 @default(0)
  itemsRead         Int                 @default(0)
  factsFound        Int                 @default(0)
  tokensReserved    BigInt              @default(0)
  inputTokensUsed   BigInt              @default(0)
  outputTokensUsed  BigInt              @default(0)
  lastError         String?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  calls             CompanyImportCall[]

  @@unique([id, spaceId, ownerUserId])
  @@unique([sourceId, unitKey])
  @@index([spaceId, ownerUserId, runId, status, availableAt])
  @@index([sourceId, status, claimExpiresAt, availableAt])
  @@map("company_import_units")
}

model CompanyImportCall {
  id               String             @id @default(cuid())
  runId            String
  run               CompanyImportRun   @relation(fields: [runId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  sourceId         String
  source            CompanyImportSource @relation(fields: [sourceId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  unitId           String
  unit              CompanyImportUnit  @relation(fields: [unitId, spaceId, ownerUserId], references: [id, spaceId, ownerUserId], onDelete: Cascade)
  spaceId          String
  space            Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  ownerUserId      String
  owner            SpaceMember        @relation("CompanyImportCallOwner", fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  reservationId    String             @unique
  claimToken       String
  reservedInput    BigInt
  reservedOutput   BigInt
  recipientKey     String
  disclosureVersion String
  actualInput      Int?
  actualOutput     Int?
  status           String             @default("reserved")
  provider         String?
  model            String?
  callId           String?
  createdAt        DateTime           @default(now())
  settledAt        DateTime?

  @@index([spaceId, ownerUserId, runId, status])
  @@map("company_import_calls")
}
