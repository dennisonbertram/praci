  dataRoomItem DataRoomItem? @relation("CompanyCandidateDataRoomItem", fields: [dataRoomItemId, spaceId, ownerUserId], references: [id, spaceId, userId], onDelete: SetNull)
  sourceItemId String
  sourceKey    String
  quote        String
  contentHash  String
